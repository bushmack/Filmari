<Window x:Class="OneButtonApp.CombinedSearchDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Совместный поиск" Height="300" Width="400"
        WindowStartupLocation="CenterOwner"
        WindowStyle="ToolWindow"
        ResizeMode="NoResize">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="100"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Название (обязательно) -->
        <TextBlock Grid.Row="0" Grid.Column="0" Text="Название:*" VerticalAlignment="Center" Margin="0,0,10,10" Foreground="Red"/>
        <TextBox Grid.Row="0" Grid.Column="1" x:Name="QueryTextBox" Margin="0,0,0,10" Padding="5"/>

        <!-- Актер -->
        <TextBlock Grid.Row="1" Grid.Column="0" Text="Актер:" VerticalAlignment="Center" Margin="0,0,10,10"/>
        <TextBox Grid.Row="1" Grid.Column="1" x:Name="ActorTextBox" Margin="0,0,0,10" Padding="5"/>

        <!-- Жанр -->
        <TextBlock Grid.Row="2" Grid.Column="0" Text="Жанр:" VerticalAlignment="Center" Margin="0,0,10,10"/>
        <TextBox Grid.Row="2" Grid.Column="1" x:Name="GenreTextBox" Margin="0,0,0,10" Padding="5"/>

        <!-- Год -->
        <TextBlock Grid.Row="3" Grid.Column="0" Text="Год:" VerticalAlignment="Center" Margin="0,0,10,10"/>
        <TextBox Grid.Row="3" Grid.Column="1" x:Name="YearTextBox" Margin="0,0,0,10" Padding="5"/>

        <!-- Кнопки -->
        <StackPanel Grid.Row="4" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Поиск" Width="80" Height="30" Margin="0,0,10,0" Click="SearchButton_Click" IsDefault="True"/>
            <Button Content="Отмена" Width="80" Height="30" Click="CancelButton_Click" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>