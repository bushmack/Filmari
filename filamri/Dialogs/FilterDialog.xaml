<Window x:Class="filamri.Dialogs.FilterDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Поиск по фильтру" 
        Height="750" 
        Width="650"
        WindowStartupLocation="CenterOwner"
        WindowStyle="ToolWindow"
        ResizeMode="NoResize"
        Background="#FFF5F5F5"
        Loaded="Window_Loaded">

    <Window.Resources>
        <!-- Стиль для текстовых полей -->
        <Style x:Key="RoundedTextBox" TargetType="TextBox">
            <Setter Property="Padding" Value="8"/>
            <Setter Property="BorderBrush" Value="#FFDDDDDD"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="2"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Стиль для комбобоксов -->
        <Style x:Key="RoundedComboBox" TargetType="ComboBox">
            <Setter Property="Padding" Value="8"/>
            <Setter Property="BorderBrush" Value="#FFDDDDDD"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="border" 
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="5">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ContentPresenter x:Name="contentPresenter" 
                                                    Grid.Column="0"
                                                    Margin="6,2"
                                                    Content="{TemplateBinding SelectionBoxItem}"
                                                    ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                    VerticalAlignment="Center"/>
                                    <ToggleButton x:Name="toggleButton" 
                                                  Grid.Column="1"
                                                  Width="20"
                                                  Height="20"
                                                  Margin="2"
                                                  Background="Transparent"
                                                  BorderThickness="0"
                                                  IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                        <ToggleButton.Template>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Border Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="0"
                                                        CornerRadius="3">
                                                    <TextBlock Text="▼" 
                                                               FontSize="10"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </ToggleButton.Template>
                                    </ToggleButton>
                                </Grid>
                            </Border>
                            <Popup x:Name="PART_Popup" 
                                   IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}"
                                   Placement="Bottom"
                                   HorizontalOffset="0"
                                   VerticalOffset="2">
                                <Border Background="White"
                                        BorderBrush="#FFDDDDDD"
                                        BorderThickness="1"
                                        CornerRadius="5"
                                        MaxHeight="200"
                                        Width="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                    <ScrollViewer>
                                        <ItemsPresenter Margin="2"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEditable" Value="True">
                                <Setter TargetName="contentPresenter" Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Стиль для группы с рамкой -->
        <Style x:Key="GroupBoxStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#FFDDDDDD"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="15"/>
            <Setter Property="Margin" Value="0,0,0,15"/>
        </Style>

        <!-- Стиль для заголовков -->
        <Style x:Key="HeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#FF333333"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <!-- Стиль для контейнера выбранного элемента -->
        <Style x:Key="SelectedItemStyle" TargetType="Border">
            <Setter Property="Background" Value="#FFF0F0F0"/>
            <Setter Property="BorderBrush" Value="#FF0078D7"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="5"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <!-- Стиль для чипса (выбранного элемента) -->
        <Style x:Key="ChipStyle" TargetType="Border">
            <Setter Property="Background" Value="#FF0078D7"/>
            <Setter Property="CornerRadius" Value="15"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Margin" Value="0,2,5,2"/>
        </Style>

        <!-- Стиль для кнопок навигации -->
        <Style x:Key="NavButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="0"
                                CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Стиль для кнопки выбора -->
        <Style x:Key="SelectButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="35"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="5,0,0,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="10">
        <StackPanel Margin="10">

            <!-- Заголовок -->
            <TextBlock Text="🔍 Расширенный поиск" 
                       FontSize="24" 
                       FontWeight="Bold" 
                       HorizontalAlignment="Center" 
                       Margin="0,0,0,20">
                <TextBlock.Foreground>
                    <SolidColorBrush Color="#FFD83B01"/>
                </TextBlock.Foreground>
            </TextBlock>

            <!-- ЖАНРЫ -->
            <Border Style="{StaticResource GroupBoxStyle}">
                <StackPanel>
                    <TextBlock Text="🎭 Жанр" Style="{StaticResource HeaderStyle}"/>

                    <!-- Выбранный жанр -->
                    <Border x:Name="SelectedGenreBorder" 
                            Style="{StaticResource SelectedItemStyle}"
                            Visibility="Collapsed">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="SelectedGenreText" 
                                       VerticalAlignment="Center"
                                       FontSize="14"
                                       Foreground="#FF0078D7"
                                       FontWeight="Bold"/>
                            <Button Grid.Column="1" 
                                    Content="✖" 
                                    Width="25" 
                                    Height="25"
                                    FontSize="12"
                                    FontWeight="Bold"
                                    Background="#FFDC3545"
                                    Foreground="White"
                                    Cursor="Hand"
                                    ToolTip="Сбросить"
                                    Click="ClearGenre_Click">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                                CornerRadius="3">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Кнопка выбора жанра -->
                    <Button x:Name="ShowGenresButton" 
                            Content="🎭 Выбрать жанр"
                            Height="40"
                            FontSize="14"
                            Background="#FFE0E0E0"
                            Foreground="#FF333333"
                            Cursor="Hand"
                            Margin="0,0,0,10"
                            Click="ShowGenresButton_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}"
                                        CornerRadius="5"
                                        BorderBrush="#FFCCCCCC"
                                        BorderThickness="1">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- Панель выбора жанра (изначально скрыта) -->
                    <StackPanel x:Name="GenresPanel" Visibility="Collapsed">
                        <!-- Поиск по жанрам -->
                        <TextBox x:Name="GenreSearchBox" 
                                 Style="{StaticResource RoundedTextBox}"
                                 Margin="0,0,0,10"
                                 TextChanged="GenreSearchBox_TextChanged"/>

                        <!-- Список жанров с радио-кнопками -->
                        <ScrollViewer MaxHeight="200" VerticalScrollBarVisibility="Auto" Margin="0,0,0,10">
                            <ItemsControl x:Name="GenresListBox">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,2" Padding="5,2">
                                            <RadioButton Content="{Binding Name}" 
                                                          GroupName="GenreGroup"
                                                          IsChecked="{Binding IsSelected}"
                                                          FontSize="14"
                                                          Cursor="Hand"
                                                          Checked="GenreRadioButton_Checked"/>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <!-- Кнопки управления -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="1" 
                                    Content="Выбрать" 
                                    Width="100"
                                    Height="35"
                                    Margin="0,0,10,0"
                                    Background="#FF28A745"
                                    Foreground="White"
                                    Style="{StaticResource SelectButtonStyle}"
                                    Click="SelectGenre_Click"/>
                            <Button Grid.Column="2" 
                                    Content="Отмена" 
                                    Width="100"
                                    Height="35"
                                    Background="#FF6C757D"
                                    Foreground="White"
                                    Style="{StaticResource SelectButtonStyle}"
                                    Click="CancelGenre_Click"/>
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- СТРАНЫ -->
            <Border Style="{StaticResource GroupBoxStyle}">
                <StackPanel>
                    <TextBlock Text="🌍 Страна" Style="{StaticResource HeaderStyle}"/>

                    <!-- Выбранная страна -->
                    <Border x:Name="SelectedCountryBorder" 
                            Style="{StaticResource SelectedItemStyle}"
                            Visibility="Collapsed">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="SelectedCountryText" 
                                       VerticalAlignment="Center"
                                       FontSize="14"
                                       Foreground="#FF28A745"
                                       FontWeight="Bold"/>
                            <Button Grid.Column="1" 
                                    Content="✖" 
                                    Width="25" 
                                    Height="25"
                                    FontSize="12"
                                    FontWeight="Bold"
                                    Background="#FFDC3545"
                                    Foreground="White"
                                    Cursor="Hand"
                                    ToolTip="Сбросить"
                                    Click="ClearCountry_Click">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                                CornerRadius="3">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Кнопка выбора страны -->
                    <Button x:Name="ShowCountriesButton" 
                            Content="🌍 Выбрать страну"
                            Height="40"
                            FontSize="14"
                            Background="#FFE0E0E0"
                            Foreground="#FF333333"
                            Cursor="Hand"
                            Margin="0,0,0,10"
                            Click="ShowCountriesButton_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}"
                                        CornerRadius="5"
                                        BorderBrush="#FFCCCCCC"
                                        BorderThickness="1">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- Панель выбора страны (изначально скрыта) -->
                    <StackPanel x:Name="CountriesPanel" Visibility="Collapsed">
                        <!-- Поиск по странам -->
                        <TextBox x:Name="CountrySearchBox" 
                                 Style="{StaticResource RoundedTextBox}"
                                 Margin="0,0,0,10"
                                 TextChanged="CountrySearchBox_TextChanged"/>

                        <!-- Список стран с радио-кнопками -->
                        <ScrollViewer MaxHeight="200" VerticalScrollBarVisibility="Auto" Margin="0,0,0,10">
                            <ItemsControl x:Name="CountriesListBox">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,2" Padding="5,2">
                                            <RadioButton Content="{Binding Name}" 
                                                          GroupName="CountryGroup"
                                                          IsChecked="{Binding IsSelected}"
                                                          FontSize="14"
                                                          Cursor="Hand"
                                                          Checked="CountryRadioButton_Checked"/>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <!-- Кнопки управления -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="1" 
                                    Content="Выбрать" 
                                    Width="100"
                                    Height="35"
                                    Margin="0,0,10,0"
                                    Background="#FF28A745"
                                    Foreground="White"
                                    Style="{StaticResource SelectButtonStyle}"
                                    Click="SelectCountry_Click"/>
                            <Button Grid.Column="2" 
                                    Content="Отмена" 
                                    Width="100"
                                    Height="35"
                                    Background="#FF6C757D"
                                    Foreground="White"
                                    Style="{StaticResource SelectButtonStyle}"
                                    Click="CancelCountry_Click"/>
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Год выпуска -->
            <Border Style="{StaticResource GroupBoxStyle}">
                <StackPanel>
                    <TextBlock Text="📅 Год выпуска" Style="{StaticResource HeaderStyle}"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Год с -->
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="С" Margin="0,0,0,5" Foreground="Gray"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="YearFromTextBox" 
                                         Grid.Column="0"
                                         Text="1990"
                                         Style="{StaticResource RoundedTextBox}"
                                         TextAlignment="Center"
                                         VerticalAlignment="Center"
                                         PreviewTextInput="NumberValidationTextBox"/>
                                <StackPanel Grid.Column="1" Margin="5,0,0,0">
                                    <Button Content="▲" 
                                            Style="{StaticResource NavButtonStyle}"
                                            Click="YearFromUp_Click"
                                            FontSize="10"
                                            Padding="0"
                                            Margin="0,0,0,2">
                                        <Button.Background>
                                            <SolidColorBrush Color="#FFE0E0E0"/>
                                        </Button.Background>
                                    </Button>
                                    <Button Content="▼" 
                                            Style="{StaticResource NavButtonStyle}"
                                            Click="YearFromDown_Click"
                                            FontSize="10"
                                            Padding="0">
                                        <Button.Background>
                                            <SolidColorBrush Color="#FFE0E0E0"/>
                                        </Button.Background>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </StackPanel>

                        <!-- Разделитель -->
                        <TextBlock Grid.Column="1" 
                                   Text="—" 
                                   FontSize="20" 
                                   FontWeight="Bold" 
                                   VerticalAlignment="Center" 
                                   Margin="10,0,10,0"/>

                        <!-- Год по -->
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="По" Margin="0,0,0,5" Foreground="Gray"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="YearToTextBox" 
                                         Grid.Column="0"
                                         Text="2025"
                                         Style="{StaticResource RoundedTextBox}"
                                         TextAlignment="Center"
                                         VerticalAlignment="Center"
                                         PreviewTextInput="NumberValidationTextBox"/>
                                <StackPanel Grid.Column="1" Margin="5,0,0,0">
                                    <Button Content="▲" 
                                            Style="{StaticResource NavButtonStyle}"
                                            Click="YearToUp_Click"
                                            FontSize="10"
                                            Padding="0"
                                            Margin="0,0,0,2">
                                        <Button.Background>
                                            <SolidColorBrush Color="#FFE0E0E0"/>
                                        </Button.Background>
                                    </Button>
                                    <Button Content="▼" 
                                            Style="{StaticResource NavButtonStyle}"
                                            Click="YearToDown_Click"
                                            FontSize="10"
                                            Padding="0">
                                        <Button.Background>
                                            <SolidColorBrush Color="#FFE0E0E0"/>
                                        </Button.Background>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Рейтинг -->
            <Border Style="{StaticResource GroupBoxStyle}">
                <StackPanel>
                    <TextBlock Text="⭐ Рейтинг Кинопоиска" Style="{StaticResource HeaderStyle}"/>

                    <!-- Выбранный рейтинг -->
                    <Border x:Name="SelectedRatingBorder" 
                            Style="{StaticResource SelectedItemStyle}"
                            Visibility="Collapsed">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="SelectedRatingText" 
                                       VerticalAlignment="Center"
                                       FontSize="14"
                                       Foreground="#FFD83B01"
                                       FontWeight="Bold"/>
                            <Button Grid.Column="1" 
                                    Content="✖" 
                                    Width="25" 
                                    Height="25"
                                    FontSize="12"
                                    FontWeight="Bold"
                                    Background="#FFDC3545"
                                    Foreground="White"
                                    Cursor="Hand"
                                    ToolTip="Сбросить"
                                    Click="ClearRating_Click">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                                CornerRadius="3">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Кнопка выбора рейтинга -->
                    <Button x:Name="ShowRatingButton" 
                            Content="⭐ Выбрать рейтинг"
                            Height="40"
                            FontSize="14"
                            Background="#FFE0E0E0"
                            Foreground="#FF333333"
                            Cursor="Hand"
                            Margin="0,0,0,10"
                            Click="ShowRatingButton_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}"
                                        CornerRadius="5"
                                        BorderBrush="#FFCCCCCC"
                                        BorderThickness="1">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- Панель выбора рейтинга (изначально скрыта) -->
                    <StackPanel x:Name="RatingPanel" Visibility="Collapsed">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Рейтинг от -->
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="От" Margin="0,0,0,5" Foreground="Gray"/>
                                <ComboBox x:Name="RatingFromComboBox" 
                                          IsEditable="True"
                                          Text="5.0"
                                          Style="{StaticResource RoundedComboBox}"
                                          FontSize="14">
                                    <ComboBoxItem Content="1.0"/>
                                    <ComboBoxItem Content="2.0"/>
                                    <ComboBoxItem Content="3.0"/>
                                    <ComboBoxItem Content="4.0"/>
                                    <ComboBoxItem Content="5.0"/>
                                    <ComboBoxItem Content="6.0"/>
                                    <ComboBoxItem Content="7.0"/>
                                    <ComboBoxItem Content="8.0"/>
                                    <ComboBoxItem Content="9.0"/>
                                    <ComboBoxItem Content="10.0"/>
                                </ComboBox>
                            </StackPanel>

                            <!-- Разделитель -->
                            <TextBlock Grid.Column="1" 
                                       Text="—" 
                                       FontSize="20" 
                                       FontWeight="Bold" 
                                       VerticalAlignment="Center" 
                                       Margin="10,0,10,0"/>

                            <!-- Рейтинг до -->
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="До" Margin="0,0,0,5" Foreground="Gray"/>
                                <ComboBox x:Name="RatingToComboBox" 
                                          IsEditable="True"
                                          Text="10.0"
                                          Style="{StaticResource RoundedComboBox}"
                                          FontSize="14">
                                    <ComboBoxItem Content="1.0"/>
                                    <ComboBoxItem Content="2.0"/>
                                    <ComboBoxItem Content="3.0"/>
                                    <ComboBoxItem Content="4.0"/>
                                    <ComboBoxItem Content="5.0"/>
                                    <ComboBoxItem Content="6.0"/>
                                    <ComboBoxItem Content="7.0"/>
                                    <ComboBoxItem Content="8.0"/>
                                    <ComboBoxItem Content="9.0"/>
                                    <ComboBoxItem Content="10.0"/>
                                </ComboBox>
                            </StackPanel>
                        </Grid>

                        <!-- Дополнительные опции рейтинга -->
                        <WrapPanel Margin="0,10,0,10">
                            <RadioButton x:Name="RatingAnyRadio" 
                                         Content="Любой" 
                                         GroupName="RatingGroup"
                                         IsChecked="True"
                                         Margin="0,0,15,0"
                                         Cursor="Hand"
                                         Checked="RatingOption_Checked"/>
                            <RadioButton x:Name="RatingHighRadio" 
                                         Content="Высокий (>7)" 
                                         GroupName="RatingGroup"
                                         Margin="0,0,15,0"
                                         Cursor="Hand"
                                         Checked="RatingOption_Checked"/>
                            <RadioButton x:Name="RatingMediumRadio" 
                                         Content="Средний (5-7)" 
                                         GroupName="RatingGroup"
                                         Margin="0,0,15,0"
                                         Cursor="Hand"
                                         Checked="RatingOption_Checked"/>
                            <RadioButton x:Name="RatingLowRadio" 
                                         Content="Низкий (5)" 
                                         GroupName="RatingGroup"
                                         Cursor="Hand"
                                         Checked="RatingOption_Checked"/>
                        </WrapPanel>

                        <!-- Кнопки управления -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="1" 
                                    Content="Выбрать" 
                                    Width="100"
                                    Height="35"
                                    Margin="0,0,10,0"
                                    Background="#FF28A745"
                                    Foreground="White"
                                    Style="{StaticResource SelectButtonStyle}"
                                    Click="SelectRating_Click"/>
                            <Button Grid.Column="2" 
                                    Content="Отмена" 
                                    Width="100"
                                    Height="35"
                                    Background="#FF6C757D"
                                    Foreground="White"
                                    Style="{StaticResource SelectButtonStyle}"
                                    Click="CancelRating_Click"/>
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Кнопки действий -->
            <StackPanel Orientation="Horizontal" 
                        HorizontalAlignment="Center" 
                        Margin="0,20,0,10">

                <Button Content="🔍 Поиск" 
                        Width="120" 
                        Height="45" 
                        FontSize="16"
                        FontWeight="Bold"
                        Margin="0,0,15,0"
                        Click="SearchButton_Click"
                        IsDefault="True">
                    <Button.Background>
                        <SolidColorBrush Color="#FFD83B01"/>
                    </Button.Background>
                    <Button.Foreground>
                        <SolidColorBrush Color="White"/>
                    </Button.Foreground>
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    CornerRadius="5">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <Button Content="Сбросить все" 
                        Width="120" 
                        Height="45" 
                        FontSize="14"
                        Margin="0,0,15,0"
                        Click="ResetButton_Click">
                    <Button.Background>
                        <SolidColorBrush Color="#FF6C757D"/>
                    </Button.Background>
                    <Button.Foreground>
                        <SolidColorBrush Color="White"/>
                    </Button.Foreground>
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    CornerRadius="5">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <Button Content="Отмена" 
                        Width="120" 
                        Height="45" 
                        FontSize="14"
                        Click="CancelButton_Click"
                        IsCancel="True">
                    <Button.Background>
                        <SolidColorBrush Color="#FFDC3545"/>
                    </Button.Background>
                    <Button.Foreground>
                        <SolidColorBrush Color="White"/>
                    </Button.Foreground>
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    CornerRadius="5">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Window>