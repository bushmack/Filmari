<Window x:Class="filamri.Dialogs.FilterDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="🔮 Магический фильтр" 
        Height="850" 
        Width="700"
        WindowStartupLocation="CenterOwner"
        WindowStyle="ToolWindow"
        ResizeMode="NoResize"
        Background="#FF2D3436"
        FontFamily="Segoe UI">

    <Window.Resources>
        <!-- Стиль для скругленных TextBox -->
        <Style x:Key="RoundedTextBox" TargetType="TextBox">
            <Setter Property="Padding" Value="8"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#6C5CE7"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="2"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Стиль для скругленных ComboBox -->
        <Style x:Key="RoundedComboBox" TargetType="ComboBox">
            <Setter Property="Padding" Value="8"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#FD79A8"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="border" 
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ContentPresenter x:Name="contentPresenter" 
                                                    Grid.Column="0"
                                                    Margin="6,2"
                                                    Content="{TemplateBinding SelectionBoxItem}"
                                                    VerticalAlignment="Center"/>
                                    <ToggleButton x:Name="toggleButton" 
                                                  Grid.Column="1"
                                                  Width="20"
                                                  Height="20"
                                                  Margin="2"
                                                  Background="Transparent"
                                                  BorderThickness="0"
                                                  IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                        <ToggleButton.Template>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Border Background="Transparent">
                                                    <TextBlock Text="▼" 
                                                               FontSize="10"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </ToggleButton.Template>
                                    </ToggleButton>
                                </Grid>
                            </Border>
                            <Popup x:Name="PART_Popup" 
                                   IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}"
                                   Placement="Bottom"
                                   HorizontalOffset="0"
                                   VerticalOffset="2">
                                <Border Background="White"
                                        BorderBrush="#FD79A8"
                                        BorderThickness="1"
                                        CornerRadius="5"
                                        MaxHeight="200"
                                        Width="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                    <ScrollViewer>
                                        <ItemsPresenter Margin="2"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Стиль для неоновых кнопок -->
        <Style x:Key="NeonButton" TargetType="Button">
            <Setter Property="Height" Value="45"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                CornerRadius="25"
                                Background="{TemplateBinding Background}"
                                BorderThickness="0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Стиль для карточек -->
        <Style x:Key="GlassCard" TargetType="Border">
            <Setter Property="Background" Value="#CCFFFFFF"/>
            <Setter Property="CornerRadius" Value="20"/>
            <Setter Property="Margin" Value="0,0,0,15"/>
            <Setter Property="Padding" Value="15"/>
        </Style>
    </Window.Resources>

    <Border Background="#CC2D3436" 
            CornerRadius="30" 
            Margin="20"
            Padding="25">

        <ScrollViewer VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0">

                <!-- Заголовок -->
                <TextBlock Text="🔮 Магический фильтр" 
                           FontSize="32" 
                           FontWeight="Bold" 
                           HorizontalAlignment="Center" 
                           Margin="0,0,0,25"
                           Foreground="White"/>

                <!-- ЖАНРЫ -->
                <Border Style="{StaticResource GlassCard}">
                    <StackPanel>
                        <TextBlock Text="🎭 Жанр" FontSize="20" FontWeight="Bold" Foreground="#6C5CE7" Margin="0,0,0,10"/>

                        <Border x:Name="SelectedGenreBorder" 
                                Background="#6C5CE7"
                                CornerRadius="15"
                                Padding="10"
                                Margin="0,0,0,10"
                                Visibility="Collapsed">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="SelectedGenreText" 
                                           VerticalAlignment="Center"
                                           FontSize="14"
                                           Foreground="White"
                                           FontWeight="Bold"/>
                                <Button Grid.Column="1" 
                                        Content="✖" 
                                        Width="25" 
                                        Height="25"
                                        FontSize="12"
                                        Background="Transparent"
                                        Foreground="White"
                                        BorderThickness="0"
                                        Cursor="Hand"
                                        Click="ClearGenre_Click"/>
                            </Grid>
                        </Border>

                        <Button x:Name="ShowGenresButton" 
                                Content="🎭 Выбрать жанр"
                                Height="40"
                                Background="#FFE0E0E0"
                                Foreground="#2D3436"
                                FontWeight="Bold"
                                Cursor="Hand"
                                Margin="0,0,0,10"
                                Click="ShowGenresButton_Click"
                                Style="{StaticResource NeonButton}"/>

                        <StackPanel x:Name="GenresPanel" Visibility="Collapsed">
                            <TextBox x:Name="GenreSearchBox" 
                                     Style="{StaticResource RoundedTextBox}"
                                     Margin="0,0,0,10"
                                     TextChanged="GenreSearchBox_TextChanged"/>

                            <Border Background="White" CornerRadius="15" Padding="5" Margin="0,0,0,10">
                                <ScrollViewer MaxHeight="150" VerticalScrollBarVisibility="Disabled">
                                    <ItemsControl x:Name="GenresListBox">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Margin="2" Padding="5">
                                                    <RadioButton Content="{Binding Name}" 
                                                                  GroupName="GenreGroup"
                                                                  IsChecked="{Binding IsSelected}"
                                                                  FontSize="14"
                                                                  Cursor="Hand"
                                                                  Checked="GenreRadioButton_Checked"
                                                                  Foreground="#2D3436"/>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Border>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" 
                                        Content="✅ Выбрать" 
                                        Height="35"
                                        Margin="0,0,5,0"
                                        Background="#00B894"
                                        Foreground="White"
                                        Click="SelectGenre_Click"
                                        Style="{StaticResource NeonButton}"/>
                                <Button Grid.Column="1" 
                                        Content="❌ Отмена" 
                                        Height="35"
                                        Margin="5,0,0,0"
                                        Background="#D63031"
                                        Foreground="White"
                                        Click="CancelGenre_Click"
                                        Style="{StaticResource NeonButton}"/>
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- СТРАНЫ -->
                <Border Style="{StaticResource GlassCard}">
                    <StackPanel>
                        <TextBlock Text="🌍 Страна" FontSize="20" FontWeight="Bold" Foreground="#00B894" Margin="0,0,0,10"/>

                        <Border x:Name="SelectedCountryBorder" 
                                Background="#00B894"
                                CornerRadius="15"
                                Padding="10"
                                Margin="0,0,0,10"
                                Visibility="Collapsed">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="SelectedCountryText" 
                                           VerticalAlignment="Center"
                                           FontSize="14"
                                           Foreground="White"
                                           FontWeight="Bold"/>
                                <Button Grid.Column="1" 
                                        Content="✖" 
                                        Width="25" 
                                        Height="25"
                                        FontSize="12"
                                        Background="Transparent"
                                        Foreground="White"
                                        BorderThickness="0"
                                        Cursor="Hand"
                                        Click="ClearCountry_Click"/>
                            </Grid>
                        </Border>

                        <Button x:Name="ShowCountriesButton" 
                                Content="🌍 Выбрать страну"
                                Height="40"
                                Background="#FFE0E0E0"
                                Foreground="#2D3436"
                                FontWeight="Bold"
                                Cursor="Hand"
                                Margin="0,0,0,10"
                                Click="ShowCountriesButton_Click"
                                Style="{StaticResource NeonButton}"/>

                        <StackPanel x:Name="CountriesPanel" Visibility="Collapsed">
                            <TextBox x:Name="CountrySearchBox" 
                                     Style="{StaticResource RoundedTextBox}"
                                     BorderBrush="#00B894"
                                     Margin="0,0,0,10"
                                     TextChanged="CountrySearchBox_TextChanged"/>

                            <Border Background="White" CornerRadius="15" Padding="5" Margin="0,0,0,10">
                                <ScrollViewer MaxHeight="150" VerticalScrollBarVisibility="Disabled">
                                    <ItemsControl x:Name="CountriesListBox">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Margin="2" Padding="5">
                                                    <RadioButton Content="{Binding Name}" 
                                                                  GroupName="CountryGroup"
                                                                  IsChecked="{Binding IsSelected}"
                                                                  FontSize="14"
                                                                  Cursor="Hand"
                                                                  Checked="CountryRadioButton_Checked"
                                                                  Foreground="#2D3436"/>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Border>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" 
                                        Content="✅ Выбрать" 
                                        Height="35"
                                        Margin="0,0,5,0"
                                        Background="#00B894"
                                        Foreground="White"
                                        Click="SelectCountry_Click"
                                        Style="{StaticResource NeonButton}"/>
                                <Button Grid.Column="1" 
                                        Content="❌ Отмена" 
                                        Height="35"
                                        Margin="5,0,0,0"
                                        Background="#D63031"
                                        Foreground="White"
                                        Click="CancelCountry_Click"
                                        Style="{StaticResource NeonButton}"/>
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ГОД -->
                <Border Style="{StaticResource GlassCard}">
                    <StackPanel>
                        <TextBlock Text="📅 Год выпуска" FontSize="20" FontWeight="Bold" Foreground="#FDCB6E" Margin="0,0,0,10"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="С" Foreground="Gray" Margin="0,0,0,3"/>
                                <TextBox x:Name="YearFromTextBox" 
                                         Text="1990"
                                         Style="{StaticResource RoundedTextBox}"
                                         BorderBrush="#FDCB6E"
                                         TextAlignment="Center"
                                         PreviewTextInput="NumberValidationTextBox"/>
                            </StackPanel>

                            <TextBlock Grid.Column="1" 
                                       Text="—" 
                                       FontSize="24" 
                                       FontWeight="Bold" 
                                       Foreground="#FDCB6E"
                                       VerticalAlignment="Center" 
                                       Margin="10,0,10,0"/>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="По" Foreground="Gray" Margin="0,0,0,3"/>
                                <TextBox x:Name="YearToTextBox" 
                                         Text="2025"
                                         Style="{StaticResource RoundedTextBox}"
                                         BorderBrush="#FDCB6E"
                                         TextAlignment="Center"
                                         PreviewTextInput="NumberValidationTextBox"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- РЕЙТИНГ -->
                <Border Style="{StaticResource GlassCard}">
                    <StackPanel>
                        <TextBlock Text="⭐ Рейтинг" FontSize="20" FontWeight="Bold" Foreground="#FD79A8" Margin="0,0,0,10"/>

                        <Border x:Name="SelectedRatingBorder" 
                                Background="#FD79A8"
                                CornerRadius="15"
                                Padding="10"
                                Margin="0,0,0,10"
                                Visibility="Collapsed">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="SelectedRatingText" 
                                           VerticalAlignment="Center"
                                           FontSize="14"
                                           Foreground="White"
                                           FontWeight="Bold"/>
                                <Button Grid.Column="1" 
                                        Content="✖" 
                                        Width="25" 
                                        Height="25"
                                        FontSize="12"
                                        Background="Transparent"
                                        Foreground="White"
                                        BorderThickness="0"
                                        Cursor="Hand"
                                        Click="ClearRating_Click"/>
                            </Grid>
                        </Border>

                        <Button x:Name="ShowRatingButton" 
                                Content="⭐ Выбрать рейтинг"
                                Height="40"
                                Background="#FFE0E0E0"
                                Foreground="#2D3436"
                                FontWeight="Bold"
                                Cursor="Hand"
                                Margin="0,0,0,10"
                                Click="ShowRatingButton_Click"
                                Style="{StaticResource NeonButton}"/>

                        <StackPanel x:Name="RatingPanel" Visibility="Collapsed">
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="От" Foreground="Gray" Margin="0,0,0,3"/>
                                    <ComboBox x:Name="RatingFromComboBox" 
                                              IsEditable="True"
                                              Text="5.0"
                                              Style="{StaticResource RoundedComboBox}"
                                              FontSize="14">
                                        <ComboBoxItem Content="1.0"/>
                                        <ComboBoxItem Content="2.0"/>
                                        <ComboBoxItem Content="3.0"/>
                                        <ComboBoxItem Content="4.0"/>
                                        <ComboBoxItem Content="5.0"/>
                                        <ComboBoxItem Content="6.0"/>
                                        <ComboBoxItem Content="7.0"/>
                                        <ComboBoxItem Content="8.0"/>
                                        <ComboBoxItem Content="9.0"/>
                                        <ComboBoxItem Content="10.0"/>
                                    </ComboBox>
                                </StackPanel>

                                <TextBlock Grid.Column="1" 
                                           Text="—" 
                                           FontSize="24" 
                                           FontWeight="Bold" 
                                           Foreground="#FD79A8"
                                           VerticalAlignment="Center" 
                                           Margin="10,0,10,0"/>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="До" Foreground="Gray" Margin="0,0,0,3"/>
                                    <ComboBox x:Name="RatingToComboBox" 
                                              IsEditable="True"
                                              Text="10.0"
                                              Style="{StaticResource RoundedComboBox}"
                                              FontSize="14">
                                        <ComboBoxItem Content="1.0"/>
                                        <ComboBoxItem Content="2.0"/>
                                        <ComboBoxItem Content="3.0"/>
                                        <ComboBoxItem Content="4.0"/>
                                        <ComboBoxItem Content="5.0"/>
                                        <ComboBoxItem Content="6.0"/>
                                        <ComboBoxItem Content="7.0"/>
                                        <ComboBoxItem Content="8.0"/>
                                        <ComboBoxItem Content="9.0"/>
                                        <ComboBoxItem Content="10.0"/>
                                    </ComboBox>
                                </StackPanel>
                            </Grid>

                            <WrapPanel HorizontalAlignment="Center" Margin="0,5">
                                <RadioButton x:Name="RatingAnyRadio" 
                                             Content="Любой" 
                                             GroupName="RatingGroup"
                                             IsChecked="True"
                                             Margin="0,0,10,0"
                                             Foreground="White"
                                             FontWeight="Bold"/>
                                <RadioButton x:Name="RatingHighRadio" 
                                             Content="Высокий (>7)" 
                                             GroupName="RatingGroup"
                                             Margin="0,0,10,0"
                                             Foreground="White"
                                             FontWeight="Bold"/>
                                <RadioButton x:Name="RatingMediumRadio" 
                                             Content="Средний (5-7)" 
                                             GroupName="RatingGroup"
                                             Margin="0,0,10,0"
                                             Foreground="White"
                                             FontWeight="Bold"/>
                                <RadioButton x:Name="RatingLowRadio" 
                                             Content="Низкий (5)" 
                                             GroupName="RatingGroup"
                                             Foreground="White"
                                             FontWeight="Bold"/>
                            </WrapPanel>

                            <Grid Margin="0,5,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" 
                                        Content="✅ Применить" 
                                        Height="35"
                                        Margin="0,0,5,0"
                                        Background="#00B894"
                                        Foreground="White"
                                        Click="SelectRating_Click"
                                        Style="{StaticResource NeonButton}"/>
                                <Button Grid.Column="1" 
                                        Content="❌ Отмена" 
                                        Height="35"
                                        Margin="5,0,0,0"
                                        Background="#D63031"
                                        Foreground="White"
                                        Click="CancelRating_Click"
                                        Style="{StaticResource NeonButton}"/>
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- КНОПКИ ДЕЙСТВИЙ -->
                <Grid Margin="0,15,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" 
                            Content="🔍 Поиск" 
                            Height="45"
                            Margin="0,0,5,0"
                            Background="#6C5CE7"
                            Foreground="White"
                            FontSize="14"
                            FontWeight="Bold"
                            Click="SearchButton_Click"
                            IsDefault="True"
                            Style="{StaticResource NeonButton}"/>

                    <Button Grid.Column="1" 
                            Content="🔄 Сброс" 
                            Height="45"
                            Margin="5,0,5,0"
                            Background="#FDCB6E"
                            Foreground="#2D3436"
                            FontSize="14"
                            FontWeight="Bold"
                            Click="ResetButton_Click"
                            Style="{StaticResource NeonButton}"/>

                    <Button Grid.Column="2" 
                            Content="✖ Отмена" 
                            Height="45"
                            Margin="5,0,0,0"
                            Background="#D63031"
                            Foreground="White"
                            FontSize="14"
                            FontWeight="Bold"
                            Click="CancelButton_Click"
                            IsCancel="True"
                            Style="{StaticResource NeonButton}"/>
                </Grid>

            </StackPanel>
        </ScrollViewer>
    </Border>
</Window>