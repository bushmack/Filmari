<UserControl x:Class="filamri.Views.FilmControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent"
             Height="Auto"
             Width="Auto">

    <Border x:Name="CardBorder"
            Background="White" 
            CornerRadius="30" 
            Margin="10" 
            Padding="20"
            Effect="{StaticResource CardShadow}">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Постер -->
            <Border Grid.Row="0" 
                    Grid.Column="0" 
                    Grid.RowSpan="4"
                    CornerRadius="20" 
                    Margin="0,0,20,0"
                    Background="{StaticResource PrimaryGradient}"
                    Padding="3">
                <Border CornerRadius="17" Background="White" Padding="3">
                    <Image x:Name="PosterImage" 
                           Height="400" 
                           Width="280" 
                           Stretch="Uniform" 
                           Margin="0"/>
                </Border>
            </Border>

            <!-- Название -->
            <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,15">
                <TextBlock x:Name="TitleText" 
                           FontSize="32" 
                           FontWeight="Bold" 
                           TextWrapping="Wrap"
                           Margin="0,0,0,15"
                           Foreground="{StaticResource DarkBrush}"/>

                <WrapPanel Margin="0,0,0,15">
                    <Border Background="{StaticResource PrimaryBrush}" 
                            CornerRadius="15" 
                            Padding="10,4" 
                            Margin="0,0,8,0">
                        <TextBlock x:Name="YearText" 
                                   FontSize="14" 
                                   Foreground="White"
                                   FontWeight="Bold"/>
                    </Border>

                    <Border Background="{StaticResource SecondaryBrush}" 
                            CornerRadius="15" 
                            Padding="10,4" 
                            Margin="0,0,8,0">
                        <TextBlock x:Name="GenreText" 
                                   FontSize="14" 
                                   Foreground="White"
                                   FontWeight="Bold"
                                   TextWrapping="Wrap"
                                   MaxWidth="300"/>
                    </Border>

                    <Border Background="Gold" 
                            CornerRadius="15" 
                            Padding="10,4">
                        <TextBlock x:Name="RatingText" 
                                   FontSize="14" 
                                   Foreground="Black"
                                   FontWeight="Bold"/>
                    </Border>
                </WrapPanel>

                <Border Background="{StaticResource DarkBrush}" 
                        CornerRadius="10" 
                        Padding="8,4" 
                        Margin="0,0,0,5"
                        Opacity="0.8">
                    <TextBlock x:Name="CountryText" 
                               FontSize="12" 
                               Foreground="White"/>
                </Border>

                <Border Background="{StaticResource AccentBrush}" 
                        CornerRadius="10" 
                        Padding="8,4"
                        Opacity="0.8">
                    <TextBlock x:Name="LengthText" 
                               FontSize="12" 
                               Foreground="White"/>
                </Border>
            </StackPanel>

            <!-- Актеры -->
            <Border Grid.Row="1" 
                    Grid.Column="1" 
                    CornerRadius="15"
                    Background="#E0E0E0"
                    Padding="12"
                    Margin="0,0,0,12">
                <TextBlock x:Name="ActorsText" 
                           FontSize="13" 
                           Foreground="#333"
                           TextWrapping="Wrap"
                           MaxHeight="60"/>
            </Border>

            <!-- Описание -->
            <Border Grid.Row="2" 
                    Grid.Column="1" 
                    CornerRadius="15"
                    Background="#F0F0F0"
                    Padding="15">
                <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="120">
                    <TextBlock x:Name="DescriptionText" 
                               FontSize="13" 
                               TextWrapping="Wrap"
                               LineHeight="20"
                               Foreground="#2D3436"/>
                </ScrollViewer>
            </Border>

            <!-- Кнопка комментариев -->
            <Border Grid.Row="3" 
                    Grid.Column="1" 
                    CornerRadius="15"
                    Padding="12"
                    Margin="0,12,0,0">
                <Button x:Name="CommentsButton"
                        Content="💬 Комментарии"
                        Height="35"
                        FontSize="13"
                        FontWeight="Bold"
                        Background="{StaticResource PrimaryBrush}"
                        Foreground="White"
                        Cursor="Hand"
                        Click="CommentsButton_Click"/>
            </Border>
        </Grid>
    </Border>
</UserControl>