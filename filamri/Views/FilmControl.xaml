<UserControl x:Class="filamri.Views.FilmControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent"
             Cursor="Hand">
    <Border Background="White" 
            BorderBrush="#FFDDDDDD" 
            BorderThickness="1" 
            CornerRadius="8" 
            Margin="5" 
            Padding="10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Постер -->
            <Image Grid.Row="0" 
                   Grid.Column="0" 
                   x:Name="PosterImage" 
                   Height="200" 
                   Width="130" 
                   Stretch="Uniform" 
                   Margin="5" 
                   Grid.RowSpan="2"/>

            <!-- Информация о фильме -->
            <StackPanel Grid.Row="0" Grid.Column="1" Margin="10,5">
                <TextBlock x:Name="TitleText" 
                           FontSize="20" 
                           FontWeight="Bold" 
                           TextWrapping="Wrap"
                           Margin="0,0,0,5"/>

                <WrapPanel Margin="0,5">
                    <TextBlock x:Name="YearText" 
                               FontSize="14" 
                               Foreground="Gray" 
                               Margin="0,0,10,0"/>
                    <TextBlock x:Name="GenreText" 
                               FontSize="14" 
                               Foreground="Gray"
                               TextWrapping="Wrap"/>
                    <TextBlock x:Name="RatingText" 
                               FontSize="14" 
                               Foreground="Gold" 
                               FontWeight="Bold"
                               Margin="10,0,0,0"/>
                </WrapPanel>

                <!-- Актеры -->
                <TextBlock x:Name="ActorsText" 
                           FontSize="12" 
                           Foreground="#FF0078D7" 
                           TextWrapping="Wrap"
                           MaxHeight="60"
                           Margin="0,5"/>
            </StackPanel>

            <!-- Описание -->
            <ScrollViewer Grid.Row="1" 
                         Grid.Column="1" 
                         VerticalScrollBarVisibility="Auto"
                         MaxHeight="120">
                <TextBlock x:Name="DescriptionText" 
                           FontSize="12" 
                           TextWrapping="Wrap"
                           Margin="10,0,10,5"/>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>