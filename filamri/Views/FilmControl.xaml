<UserControl x:Class="filamri.Views.FilmControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent"
             Height="Auto"
             Width="Auto">
    <Border Background="White" 
            BorderBrush="#FFDDDDDD" 
            BorderThickness="1" 
            CornerRadius="12" 
            Margin="10" 
            Padding="25">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="350"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Постер (увеличенный) -->
            <Border Grid.Row="0" 
                    Grid.Column="0" 
                    Grid.RowSpan="3"
                    BorderBrush="#FFDDDDDD" 
                    BorderThickness="1" 
                    CornerRadius="8" 
                    Margin="0,0,25,0"
                    Background="#FFF9F9F9">
                <Image x:Name="PosterImage" 
                       Height="450" 
                       Width="320" 
                       Stretch="Uniform" 
                       Margin="5"/>
            </Border>

            <!-- Название и основные параметры -->
            <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,15">
                <TextBlock x:Name="TitleText" 
                           FontSize="36" 
                           FontWeight="Bold" 
                           TextWrapping="Wrap"
                           Margin="0,0,0,15"
                           LineHeight="42"/>

                <WrapPanel Margin="0,5,0,15">
                    <TextBlock x:Name="YearText" 
                               FontSize="20" 
                               Foreground="Gray" 
                               Margin="0,0,15,0"/>
                    <TextBlock x:Name="GenreText" 
                               FontSize="20" 
                               Foreground="Gray"
                               TextWrapping="Wrap"
                               MaxWidth="400"/>
                    <TextBlock x:Name="RatingText" 
                               FontSize="20" 
                               Foreground="Gold" 
                               FontWeight="Bold"
                               Margin="15,0,0,0"/>
                </WrapPanel>

                <TextBlock x:Name="CountryText" 
                           FontSize="18" 
                           Foreground="Gray"
                           Margin="0,5,0,5"/>

                <TextBlock x:Name="LengthText" 
                           FontSize="18" 
                           Foreground="Gray"
                           Margin="0,5,0,5"/>
            </StackPanel>

            <!-- Актеры -->
            <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,20">
                <TextBlock x:Name="ActorsText" 
                           FontSize="18" 
                           Foreground="#FF0078D7" 
                           TextWrapping="Wrap"
                           LineHeight="26"/>
            </StackPanel>

            <!-- Описание (во весь экран) -->
            <ScrollViewer Grid.Row="2" 
                         Grid.Column="1" 
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Disabled">
                <TextBlock x:Name="DescriptionText" 
                           FontSize="18" 
                           TextWrapping="Wrap"
                           LineHeight="28"
                           Margin="0,10,10,0"/>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>