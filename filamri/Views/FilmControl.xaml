<UserControl x:Class="filamri.Views.FilmControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Background="White" BorderBrush="#FFDDDDDD" BorderThickness="1" CornerRadius="8" Margin="10" Padding="10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Постер -->
            <Image Grid.Row="0" Grid.Column="0" x:Name="PosterImage" 
                   Height="250" Width="180" Stretch="Uniform" 
                   Margin="5" Grid.RowSpan="2"/>

            <!-- Информация о фильме -->
            <StackPanel Grid.Row="0" Grid.Column="1" Margin="10,5">
                <TextBlock x:Name="TitleText" FontSize="24" FontWeight="Bold" TextWrapping="Wrap"/>

                <WrapPanel Margin="0,5">
                    <TextBlock x:Name="YearText" FontSize="14" Foreground="Gray" Margin="0,0,10,0"/>
                    <TextBlock x:Name="GenreText" FontSize="14" Foreground="Gray"/>
                    <TextBlock x:Name="RatingText" FontSize="14" Foreground="Gold" Margin="10,0,0,0"/>
                    <TextBlock x:Name="CountryText" FontSize="14" Foreground="Gray" Margin="10,0,0,0"/>
                </WrapPanel>

                <TextBlock x:Name="ActorsText" FontSize="12" Foreground="Blue" Margin="0,5"/>
            </StackPanel>

            <!-- Описание -->
            <ScrollViewer Grid.Row="1" Grid.Column="1" VerticalScrollBarVisibility="Auto" Margin="10,0,10,5">
                <TextBlock x:Name="DescriptionText" FontSize="14" TextWrapping="Wrap"/>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>