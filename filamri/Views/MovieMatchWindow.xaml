<Window x:Class="filamri.MovieMatchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Совместный поиск" 
        Height="700" 
        Width="1000"
        WindowStartupLocation="CenterOwner"
        WindowStyle="ToolWindow"
        ResizeMode="NoResize"
        Background="#FFF5F5F5"
        Closed="Window_Closed">

    <Window.Resources>
        <!-- Стиль для кнопок -->
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="50"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Стиль для текстовых полей -->
        <Style x:Key="RoundedTextBox" TargetType="TextBox">
            <Setter Property="Padding" Value="8"/>
            <Setter Property="BorderBrush" Value="#FFDDDDDD"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="2"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Стиль для группы с рамкой -->
        <Style x:Key="GroupBoxStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#FFDDDDDD"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="10"/>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- ЭКРАН 1: Главное меню -->
        <Grid x:Name="MainMenuGrid" Visibility="Visible">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Заголовок -->
            <StackPanel Grid.Row="0" Margin="20">
                <TextBlock Text="🤝 Совместный поиск" 
                           FontSize="32" 
                           FontWeight="Bold" 
                           HorizontalAlignment="Center">
                    <TextBlock.Foreground>
                        <SolidColorBrush Color="#FFD83B01"/>
                    </TextBlock.Foreground>
                </TextBlock>
                <TextBlock Text="Найдите фильм, который понравится вам обоим" 
                           FontSize="18" 
                           HorizontalAlignment="Center" 
                           Margin="0,10"/>
            </StackPanel>

            <!-- Основные кнопки -->
            <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Width="400">
                <Border Style="{StaticResource GroupBoxStyle}" Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="Создать комнату" 
                                   FontSize="20" 
                                   FontWeight="Bold" 
                                   HorizontalAlignment="Center" 
                                   Margin="0,0,0,15"/>
                        <Button Content="➕ Создать комнату" 
                                Style="{StaticResource ActionButtonStyle}"
                                Background="#FF28A745"
                                Foreground="White"
                                Margin="0,0,0,10"
                                Click="CreateRoom_Click"/>
                        <TextBlock x:Name="YourIdText" 
                                   Text="Ваш ID: (будет создан при создании комнаты)" 
                                   FontSize="14" 
                                   Foreground="Gray" 
                                   TextWrapping="Wrap" 
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource GroupBoxStyle}">
                    <StackPanel>
                        <TextBlock Text="Присоединиться к комнате" 
                                   FontSize="20" 
                                   FontWeight="Bold" 
                                   HorizontalAlignment="Center" 
                                   Margin="0,0,0,15"/>
                        <TextBox x:Name="RoomIdTextBox" 
                                 Style="{StaticResource RoundedTextBox}"
                                 Margin="0,0,0,10"
                                 TextChanged="RoomIdTextBox_TextChanged"/>
                        <Button x:Name="JoinRoomButton" 
                                Content="🔗 Присоединиться" 
                                Style="{StaticResource ActionButtonStyle}"
                                Background="#FF0078D7"
                                Foreground="White"
                                IsEnabled="False"
                                Click="JoinRoom_Click"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Кнопка назад -->
            <Button Grid.Row="2" 
                    Content="← Назад в главное меню" 
                    Width="200" 
                    Height="40" 
                    Margin="10"
                    HorizontalAlignment="Left"
                    Background="#FF6C757D"
                    Foreground="White"
                    Click="BackToMain_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Grid>

        <!-- ЭКРАН 2: Выбор жанров -->
        <Grid x:Name="GenreSelectionGrid" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Заголовок -->
            <StackPanel Grid.Row="0" Margin="20">
                <TextBlock x:Name="RoomInfoText" 
                           Text="Выбор жанров" 
                           FontSize="28" 
                           FontWeight="Bold" 
                           HorizontalAlignment="Center"/>
                <TextBlock x:Name="PartnerStatusText" 
                           Text="Ожидание подтверждения партнера..." 
                           FontSize="14" 
                           Foreground="Gray" 
                           HorizontalAlignment="Center" 
                           Margin="0,10"/>
            </StackPanel>

            <!-- Список жанров (как в FilterDialog) -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="20">
                <StackPanel>
                    <TextBlock Text="Выберите интересующие вас жанры:" 
                               FontSize="16" 
                               Margin="0,0,0,10"/>

                    <!-- Поиск по жанрам -->
                    <TextBox x:Name="GenreSearchBox" 
                             Style="{StaticResource RoundedTextBox}"
                             Margin="0,0,0,10"
                             TextChanged="GenreSearchBox_TextChanged"/>

                    <!-- Список жанров с чекбоксами -->
                    <ScrollViewer MaxHeight="400" VerticalScrollBarVisibility="Auto" Margin="0,0,0,10">
                        <ItemsControl x:Name="GenresListBox">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,2" Padding="5,2">
                                        <CheckBox Content="{Binding Name}" 
                                                  IsChecked="{Binding IsSelected}"
                                                  FontSize="14"
                                                  Cursor="Hand"/>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>
            </ScrollViewer>

            <!-- Кнопки управления -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,20">
                <Button Content="✅ Готово" 
                        Width="120" 
                        Height="45" 
                        FontSize="16"
                        Background="#FF28A745"
                        Foreground="White"
                        Margin="0,0,10,0"
                        Click="ConfirmGenres_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    CornerRadius="5">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <Button Content="↩️ Отмена" 
                        Width="120" 
                        Height="45" 
                        FontSize="16"
                        Background="#FFDC3545"
                        Foreground="White"
                        Click="CancelGenres_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    CornerRadius="5">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </Grid>

        <!-- ЭКРАН 3: Свайп фильмов -->
        <Grid x:Name="SwipeGrid" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Информация о комнате -->
            <StackPanel Grid.Row="0" Margin="10" HorizontalAlignment="Center">
                <TextBlock x:Name="SwipeRoomInfoText" 
                           FontSize="14" 
                           Foreground="Gray" 
                           HorizontalAlignment="Center"/>
                <TextBlock x:Name="SwipeStatusText" 
                           FontSize="12" 
                           Foreground="Gray" 
                           HorizontalAlignment="Center" 
                           Margin="0,5"/>
            </StackPanel>

            <!-- Карточка фильма -->
            <Border Grid.Row="1" 
                    Margin="20" 
                    Padding="20" 
                    Background="White" 
                    BorderBrush="#FFDDDDDD" 
                    BorderThickness="2" 
                    CornerRadius="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Image Grid.Row="0" x:Name="SwipePosterImage" 
                           Height="350" 
                           Stretch="Uniform" 
                           Margin="10"/>
                    <TextBlock Grid.Row="1" x:Name="SwipeTitleText" 
                               FontSize="28" 
                               FontWeight="Bold" 
                               HorizontalAlignment="Center" 
                               Margin="10"/>
                    <WrapPanel Grid.Row="2" HorizontalAlignment="Center" Margin="10">
                        <TextBlock x:Name="SwipeYearText" 
                                   FontSize="16" 
                                   Foreground="Gray" 
                                   Margin="0,0,10,0"/>
                        <TextBlock x:Name="SwipeGenreText" 
                                   FontSize="16" 
                                   Foreground="Gray" 
                                   Margin="0,0,10,0"/>
                        <TextBlock x:Name="SwipeRatingText" 
                                   FontSize="16" 
                                   Foreground="Gold" 
                                   FontWeight="Bold"/>
                    </WrapPanel>
                    <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" MaxHeight="150">
                        <TextBlock x:Name="SwipeDescriptionText" 
                                   FontSize="14" 
                                   TextWrapping="Wrap" 
                                   Margin="10"/>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- Кнопки свайпа -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="20">
                <Button Content="❤️ Нравится" 
                        Width="180" 
                        Height="60" 
                        FontSize="20"
                        FontWeight="Bold"
                        Background="#FF28A745"
                        Foreground="White"
                        Margin="10"
                        Click="SwipeRight_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    CornerRadius="8">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <Button Content="💔 Не нравится" 
                        Width="180" 
                        Height="60" 
                        FontSize="20"
                        FontWeight="Bold"
                        Background="#FFDC3545"
                        Foreground="White"
                        Margin="10"
                        Click="SwipeLeft_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    CornerRadius="8">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>

            <!-- Индикатор партнера -->
            <TextBlock Grid.Row="3" x:Name="PartnerSwipeIndicator" 
                       Text="Ожидание выбора партнера..." 
                       FontSize="14" 
                       Foreground="Gray" 
                       HorizontalAlignment="Center" 
                       Margin="0,0,0,10"/>
        </Grid>

        <!-- ЭКРАН 4: Мэтч! -->
        <Grid x:Name="MatchGrid" Visibility="Collapsed" Background="#FFF0F8FF">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="600">
                <TextBlock Text="🎉 МЭТЧ! 🎉" 
                           FontSize="56" 
                           FontWeight="Bold" 
                           HorizontalAlignment="Center">
                    <TextBlock.Foreground>
                        <SolidColorBrush Color="Green"/>
                    </TextBlock.Foreground>
                </TextBlock>
                <TextBlock Text="Вы оба хотите посмотреть:" 
                           FontSize="24" 
                           HorizontalAlignment="Center" 
                           Margin="20"/>
                <Border BorderThickness="4" 
                        CornerRadius="15" 
                        Padding="30" 
                        Margin="20" 
                        Background="White">
                    <Border.BorderBrush>
                        <SolidColorBrush Color="Gold"/>
                    </Border.BorderBrush>
                    <StackPanel>
                        <TextBlock x:Name="MatchTitleText" 
                                   FontSize="32" 
                                   FontWeight="Bold" 
                                   HorizontalAlignment="Center"/>
                        <TextBlock x:Name="MatchYearText" 
                                   FontSize="20" 
                                   HorizontalAlignment="Center" 
                                   Margin="5"/>
                        <ScrollViewer MaxHeight="200" VerticalScrollBarVisibility="Auto">
                            <TextBlock x:Name="MatchDescriptionText" 
                                       FontSize="16" 
                                       TextWrapping="Wrap" 
                                       Margin="10"/>
                        </ScrollViewer>
                    </StackPanel>
                </Border>
                <Button Content="Начать просмотр" 
                        Width="250" 
                        Height="60" 
                        FontSize="20" 
                        Background="Green" 
                        Foreground="White"
                        Click="StartWatching_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    CornerRadius="8">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</Window>