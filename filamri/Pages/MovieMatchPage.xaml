<Page x:Class="filamri.Pages.MovieMatchPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Совместный просмотр" Height="700" Width="1000"
      Background="White">

    <Grid>
        <!-- Экран 1: Создание/подключение -->
        <Grid x:Name="SetupGrid" Visibility="Visible">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="20">
                <TextBlock Text="Совместный просмотр" FontSize="32" FontWeight="Bold" 
                           HorizontalAlignment="Center">
                    <TextBlock.Foreground>
                        <SolidColorBrush Color="#FF0078D7"/>
                    </TextBlock.Foreground>
                </TextBlock>
                <TextBlock Text="Найдите фильм, который понравится вам обоим" 
                           FontSize="18" HorizontalAlignment="Center" Margin="0,10"/>
            </StackPanel>

            <Grid Grid.Row="1" Margin="50">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Создать комнату -->
                <Border Grid.Column="0" Margin="20" Padding="20" 
                        BorderBrush="#FFDDDDDD" BorderThickness="1" CornerRadius="10">
                    <StackPanel>
                        <TextBlock Text="Создать комнату" FontSize="22" FontWeight="Bold" Margin="0,0,0,20"/>

                        <TextBlock Text="Ваше имя:" Margin="0,0,0,5"/>
                        <TextBox x:Name="HostNameTextBox" Text="Пользователь 1" 
                                 Margin="0,0,0,15" Padding="5"/>

                        <TextBlock Text="Выберите жанры:" Margin="0,0,0,10"/>
                        <ListBox x:Name="HostGenresListBox" Height="150" SelectionMode="Multiple" 
                                 Margin="0,0,0,15" BorderBrush="#FFDDDDDD">
                            <ListBoxItem>боевик</ListBoxItem>
                            <ListBoxItem>комедия</ListBoxItem>
                            <ListBoxItem>драма</ListBoxItem>
                            <ListBoxItem>фантастика</ListBoxItem>
                            <ListBoxItem>ужасы</ListBoxItem>
                            <ListBoxItem>триллер</ListBoxItem>
                            <ListBoxItem>мелодрама</ListBoxItem>
                            <ListBoxItem>детектив</ListBoxItem>
                        </ListBox>

                        <Button Content="Создать комнату" Height="45" FontSize="16" Click="CreateRoom_Click">
                            <Button.Background>
                                <SolidColorBrush Color="#FF0078D7"/>
                            </Button.Background>
                            <Button.Foreground>
                                <SolidColorBrush Color="White"/>
                            </Button.Foreground>
                        </Button>

                        <TextBlock x:Name="CreatedRoomInfo" TextWrapping="Wrap" 
                                   Margin="0,10" Foreground="Green"/>
                    </StackPanel>
                </Border>

                <!-- Подключиться к комнате -->
                <Border Grid.Column="1" Margin="20" Padding="20" 
                        BorderBrush="#FFDDDDDD" BorderThickness="1" CornerRadius="10">
                    <StackPanel>
                        <TextBlock Text="Подключиться к комнате" FontSize="22" FontWeight="Bold" Margin="0,0,0,20"/>

                        <TextBlock Text="Ваше имя:" Margin="0,0,0,5"/>
                        <TextBox x:Name="JoinerNameTextBox" Text="Пользователь 2" 
                                 Margin="0,0,0,15" Padding="5"/>

                        <TextBlock Text="ID комнаты:" Margin="0,0,0,5"/>
                        <TextBox x:Name="RoomIdTextBox" Margin="0,0,0,15" Padding="5"/>

                        <TextBlock Text="Выберите жанры:" Margin="0,0,0,10"/>
                        <ListBox x:Name="JoinerGenresListBox" Height="150" SelectionMode="Multiple" 
                                 Margin="0,0,0,15" BorderBrush="#FFDDDDDD">
                            <ListBoxItem>боевик</ListBoxItem>
                            <ListBoxItem>комедия</ListBoxItem>
                            <ListBoxItem>драма</ListBoxItem>
                            <ListBoxItem>фантастика</ListBoxItem>
                            <ListBoxItem>ужасы</ListBoxItem>
                            <ListBoxItem>триллер</ListBoxItem>
                            <ListBoxItem>мелодрама</ListBoxItem>
                            <ListBoxItem>детектив</ListBoxItem>
                        </ListBox>

                        <Button Content="Подключиться" Height="45" FontSize="16" Click="JoinRoom_Click">
                            <Button.Background>
                                <SolidColorBrush Color="#FF0078D7"/>
                            </Button.Background>
                            <Button.Foreground>
                                <SolidColorBrush Color="White"/>
                            </Button.Foreground>
                        </Button>

                        <TextBlock x:Name="JoinErrorText" TextWrapping="Wrap" 
                                   Margin="0,10" Foreground="Red"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- Экран 2: Ожидание -->
        <Grid x:Name="WaitingGrid" Visibility="Collapsed" Background="#FFF5F5F5">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="Ожидание второго участника..." FontSize="28" Margin="20"/>
                <ProgressBar IsIndeterminate="True" Height="20" Width="400" Margin="20"/>
                <TextBlock x:Name="WaitingRoomInfo" Text="" FontSize="18" Margin="20"/>
                <Button Content="Отмена" Width="150" Height="40" FontSize="14" Click="CancelWaiting_Click"/>
            </StackPanel>
        </Grid>

        <!-- Экран 3: Выбор жанров -->
        <Grid x:Name="GenresGrid" Visibility="Collapsed">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="500">
                <TextBlock Text="Выбор жанров" FontSize="28" FontWeight="Bold" 
                           HorizontalAlignment="Center" Margin="20">
                    <TextBlock.Foreground>
                        <SolidColorBrush Color="#FF0078D7"/>
                    </TextBlock.Foreground>
                </TextBlock>
                <TextBlock Text="Выберите жанры, которые хотите посмотреть:" 
                           FontSize="16" Margin="0,0,0,10"/>
                <ListBox x:Name="FinalGenresListBox" Height="250" SelectionMode="Multiple" 
                         Margin="0,0,0,20" BorderBrush="#FFDDDDDD">
                    <ListBoxItem>боевик</ListBoxItem>
                    <ListBoxItem>комедия</ListBoxItem>
                    <ListBoxItem>драма</ListBoxItem>
                    <ListBoxItem>фантастика</ListBoxItem>
                    <ListBoxItem>ужасы</ListBoxItem>
                    <ListBoxItem>триллер</ListBoxItem>
                    <ListBoxItem>мелодрама</ListBoxItem>
                    <ListBoxItem>детектив</ListBoxItem>
                </ListBox>

                <TextBlock x:Name="PartnerStatusText" Text="Ожидание выбора партнера..." 
                           Foreground="Gray" Margin="0,0,0,10" FontSize="14"/>
                <Button Content="Готово" Height="45" FontSize="16" Click="ConfirmGenres_Click">
                    <Button.Background>
                        <SolidColorBrush Color="#FF0078D7"/>
                    </Button.Background>
                    <Button.Foreground>
                        <SolidColorBrush Color="White"/>
                    </Button.Foreground>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Экран 4: Просмотр со свайпами -->
        <Grid x:Name="SwipeGrid" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" Margin="10">
                <TextBlock x:Name="RoomInfoText" FontSize="14" Margin="5"/>
                <TextBlock x:Name="SwipeStatusText" FontSize="14" Margin="5" Foreground="Gray"/>
            </StackPanel>

            <!-- Карточка фильма -->
            <Border Grid.Row="1" Margin="20" Padding="20" BorderThickness="3" CornerRadius="10" Background="White">
                <Border.BorderBrush>
                    <SolidColorBrush Color="#FF0078D7"/>
                </Border.BorderBrush>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Image Grid.Row="0" x:Name="SwipePosterImage" Height="300" Stretch="Uniform" Margin="10"/>
                    <TextBlock Grid.Row="1" x:Name="SwipeTitleText" FontSize="28" FontWeight="Bold" 
                               HorizontalAlignment="Center" Margin="10"/>
                    <TextBlock Grid.Row="2" x:Name="SwipeYearText" FontSize="16" 
                               HorizontalAlignment="Center" Margin="5"/>
                    <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
                        <TextBlock x:Name="SwipeDescriptionText" FontSize="14" 
                                   TextWrapping="Wrap" Margin="10"/>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- Кнопки-свайпы -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="20">
                <Button Content="💔 Не нравится" Width="180" Height="60" FontSize="18" 
                        BorderBrush="#FFCCCCCC" Click="SwipeLeft_Click" Margin="10">
                    <Button.Background>
                        <SolidColorBrush Color="#FFF0F0F0"/>
                    </Button.Background>
                </Button>
                <Button Content="❤️ Нравится" Width="180" Height="60" FontSize="18" 
                        BorderBrush="#FF0078D7" Click="SwipeRight_Click" Margin="10">
                    <Button.Background>
                        <SolidColorBrush Color="#FFE6F0FF"/>
                    </Button.Background>
                </Button>
            </StackPanel>

            <TextBlock Grid.Row="2" x:Name="PartnerSwipeIndicator" 
                       HorizontalAlignment="Right" VerticalAlignment="Bottom" 
                       Margin="20" FontSize="14" Foreground="Gray"/>
        </Grid>

        <!-- Экран 5: Мэтч! -->
        <Grid x:Name="MatchGrid" Visibility="Collapsed" Background="#FFF0F8FF">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="50" Width="600">
                <TextBlock Text="🎉 МЭТЧ! 🎉" FontSize="56" FontWeight="Bold" 
                           HorizontalAlignment="Center">
                    <TextBlock.Foreground>
                        <SolidColorBrush Color="Green"/>
                    </TextBlock.Foreground>
                </TextBlock>
                <TextBlock Text="Вы оба хотите посмотреть:" FontSize="24" 
                           HorizontalAlignment="Center" Margin="20"/>
                <Border BorderThickness="4" CornerRadius="15" Padding="30" Margin="20"
                        Background="White">
                    <Border.BorderBrush>
                        <SolidColorBrush Color="Gold"/>
                    </Border.BorderBrush>
                    <StackPanel>
                        <TextBlock x:Name="MatchTitleText" FontSize="32" FontWeight="Bold" 
                                   HorizontalAlignment="Center"/>
                        <TextBlock x:Name="MatchYearText" FontSize="20" 
                                   HorizontalAlignment="Center" Margin="5"/>
                        <ScrollViewer MaxHeight="200" VerticalScrollBarVisibility="Auto">
                            <TextBlock x:Name="MatchDescriptionText" FontSize="16" 
                                       TextWrapping="Wrap" Margin="10"/>
                        </ScrollViewer>
                    </StackPanel>
                </Border>
                <Button Content="Начать просмотр" Width="250" Height="60" FontSize="20" Click="StartWatching_Click">
                    <Button.Background>
                        <SolidColorBrush Color="Green"/>
                    </Button.Background>
                    <Button.Foreground>
                        <SolidColorBrush Color="White"/>
                    </Button.Foreground>
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</Page>