<Window x:Class="filamri.CollectionDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Фильмы в подборке" 
        Height="750" 
        Width="1000"
        WindowStartupLocation="CenterOwner"
        WindowStyle="ToolWindow"
        ResizeMode="NoResize"
        Background="#FF2D3436"
        FontFamily="Segoe UI">

    <Window.Resources>
        <Style x:Key="GlassCard" TargetType="Border">
            <Setter Property="Background" Value="#CCFFFFFF"/>
            <Setter Property="CornerRadius" Value="20"/>
            <Setter Property="Margin" Value="0,0,0,15"/>
            <Setter Property="Padding" Value="20"/>
        </Style>

        <Style x:Key="NeonButton" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                CornerRadius="20"
                                Background="{TemplateBinding Background}"
                                BorderThickness="0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="#CC2D3436" 
            CornerRadius="30" 
            Margin="20"
            Padding="25">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Заголовок с кнопкой назад -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,20">
                <Button Content="← Назад" 
                        Width="120" 
                        Height="40"
                        Background="#6C5CE7"
                        Foreground="White"
                        FontSize="14"
                        FontWeight="Bold"
                        Click="BackButton_Click"
                        Style="{StaticResource NeonButton}"/>
                <TextBlock x:Name="CollectionTitle" 
                           FontSize="28" 
                           FontWeight="Bold" 
                           Foreground="White"
                           VerticalAlignment="Center"
                           Margin="20,0,0,0"/>
            </StackPanel>

            <!-- Список фильмов -->
            <ScrollViewer Grid.Row="1" 
                          VerticalScrollBarVisibility="Disabled" 
                          HorizontalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="MoviesList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource GlassCard}" Cursor="Hand" MouseLeftButtonUp="Border_MouseLeftButtonUp" Tag="{Binding}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Постер -->
                                    <Border Grid.Column="0" 
                                            CornerRadius="10" 
                                            BorderBrush="#6C5CE7" 
                                            BorderThickness="2"
                                            Margin="0,0,15,0">
                                        <Image Source="{Binding PosterUrl}" 
                                               Height="140" 
                                               Width="100" 
                                               Stretch="Uniform"/>
                                    </Border>

                                    <!-- Информация -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" 
                                                   FontSize="18" 
                                                   FontWeight="Bold"
                                                   Foreground="#2D3436"
                                                   Margin="0,0,0,5"/>
                                        <WrapPanel Margin="0,0,0,5">
                                            <TextBlock Text="{Binding Year}" 
                                                       FontSize="14" 
                                                       Foreground="#6C5CE7"
                                                       FontWeight="Bold"
                                                       Margin="0,0,10,0"/>
                                            <TextBlock Text="{Binding GenresString}" 
                                                       FontSize="14" 
                                                       Foreground="#00B894"
                                                       FontWeight="Bold"/>
                                        </WrapPanel>
                                        <TextBlock>
                                            <TextBlock.Text>
                                                <MultiBinding StringFormat="★ {0:F1}">
                                                    <Binding Path="Rating"/>
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                        <TextBlock Text="{Binding EpisodeLength}" 
                                                   FontSize="13" 
                                                   Foreground="#FD79A8"
                                                   Margin="0,5,0,0"/>
                                    </StackPanel>

                                    <!-- Кнопка удаления -->
                                    <Button Grid.Column="2" 
                                            Content="❌" 
                                            Width="35" 
                                            Height="35"
                                            FontSize="14"
                                            Background="#D63031"
                                            Foreground="White"
                                            Tag="{Binding}"
                                            Click="RemoveFromCollection_Click"
                                            Style="{StaticResource NeonButton}"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>