<Application x:Class="filamri.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <Color x:Key="PrimaryColor">#6C5CE7</Color>
        <Color x:Key="SecondaryColor">#00B894</Color>
        <Color x:Key="AccentColor">#FD79A8</Color>
        <Color x:Key="DarkColor">#2D3436</Color>

        <SolidColorBrush x:Key="PrimaryBrush" Color="#6C5CE7"/>
        <SolidColorBrush x:Key="SecondaryBrush" Color="#00B894"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#FD79A8"/>
        <SolidColorBrush x:Key="DarkBrush" Color="#2D3436"/>

        <LinearGradientBrush x:Key="PrimaryGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#6C5CE7" Offset="0.0"/>
            <GradientStop Color="#A29BFE" Offset="1.0"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="SecondaryGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#00B894" Offset="0.0"/>
            <GradientStop Color="#55EFC4" Offset="1.0"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="DarkGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#2D3436" Offset="0.0"/>
            <GradientStop Color="#636E72" Offset="1.0"/>
        </LinearGradientBrush>

        <DropShadowEffect x:Key="CardShadow" BlurRadius="20" Opacity="0.15" ShadowDepth="5" Color="Black"/>

        <Style x:Key="NeonButton" TargetType="Button">
            <Setter Property="Height" Value="50"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                CornerRadius="25"
                                Background="{TemplateBinding Background}"
                                BorderThickness="0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background">
                                    <Setter.Value>
                                        <SolidColorBrush Color="#4A3FB0"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Application.Resources>
</Application>