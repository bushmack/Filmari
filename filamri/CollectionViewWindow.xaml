<Window x:Class="filamri.CollectionViewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Просмотр подборки" Height="600" Width="900"
        WindowStartupLocation="CenterOwner"
        Background="#FFF5F5F5">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" x:Name="CollectionTitle" 
                   FontSize="24" FontWeight="Bold" 
                   HorizontalAlignment="Center" Margin="0,0,0,20"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="MoviesList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="White" 
                                BorderBrush="#FFDDDDDD" 
                                BorderThickness="1" 
                                CornerRadius="8" 
                                Margin="0,0,0,10"
                                Padding="15">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Image Grid.Column="0" 
                                       Source="{Binding PosterUrl}" 
                                       Height="120" 
                                       Width="80" 
                                       Stretch="Uniform"
                                       Margin="0,0,15,0"/>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" 
                                               FontSize="16" 
                                               FontWeight="Bold"
                                               Margin="0,0,0,5"/>
                                    <WrapPanel>
                                        <TextBlock Text="{Binding Year}" 
                                                   FontSize="14" 
                                                   Foreground="Gray"
                                                   Margin="0,0,10,0"/>
                                        <TextBlock Text="{Binding Genre}" 
                                                   FontSize="14" 
                                                   Foreground="Gray"/>
                                        <TextBlock Text="{Binding Rating, StringFormat=★ {0:F1}}" 
                                                   FontSize="14" 
                                                   Foreground="Gold"
                                                   Margin="10,0,0,0"/>
                                    </WrapPanel>
                                </StackPanel>

                                <Button Grid.Column="2" 
                                        Content="❌" 
                                        Width="35" 
                                        Height="35"
                                        FontSize="16"
                                        Tag="{Binding}"
                                        Click="RemoveFromCollection_Click"
                                        ToolTip="Удалить из подборки">
                                    <Button.Background>
                                        <SolidColorBrush Color="#FFDC3545"/>
                                    </Button.Background>
                                    <Button.Foreground>
                                        <SolidColorBrush Color="White"/>
                                    </Button.Foreground>
                                </Button>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Button Grid.Row="2" 
                Content="Закрыть" 
                Width="150" 
                Height="40" 
                Margin="0,20,0,0"
                HorizontalAlignment="Center"
                Click="Close_Click"/>
    </Grid>
</Window>