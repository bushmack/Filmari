<Window x:Class="filamri.SelectCollectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Выберите подборку" Height="500" Width="600"
        WindowStartupLocation="CenterOwner"
        Background="#FFF5F5F5"
        WindowStyle="ToolWindow"
        ResizeMode="NoResize">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="📚 Добавить в подборку" 
                   FontSize="24" FontWeight="Bold" 
                   HorizontalAlignment="Center" Margin="0,0,0,20">
            <TextBlock.Foreground>
                <SolidColorBrush Color="#FF107C10"/>
            </TextBlock.Foreground>
        </TextBlock>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="CollectionsList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="White" 
                                BorderBrush="#FFDDDDDD" 
                                BorderThickness="1" 
                                CornerRadius="8" 
                                Margin="0,0,0,10"
                                Padding="15"
                                Cursor="Hand"
                                MouseLeftButtonUp="Border_MouseLeftButtonUp"
                                Tag="{Binding}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{Binding Name}" 
                                               FontSize="18" 
                                               FontWeight="Bold"
                                               Margin="0,0,0,5"/>
                                    <TextBlock Text="{Binding Movies.Count, StringFormat={}{0} фильмов}" 
                                               FontSize="14" 
                                               Foreground="Gray"/>
                                </StackPanel>

                                <TextBlock Grid.Column="1" 
                                           Text="➕" 
                                           FontSize="24"
                                           VerticalAlignment="Center"
                                           Margin="10,0,0,0"
                                           Foreground="#FF107C10"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Button Grid.Row="2" 
                Content="➕ Создать новую подборку" 
                Width="200" 
                Height="45" 
                FontSize="14"
                Margin="0,20,0,0"
                HorizontalAlignment="Center"
                Click="CreateNewCollection_Click">
            <Button.Background>
                <SolidColorBrush Color="#FF107C10"/>
            </Button.Background>
            <Button.Foreground>
                <SolidColorBrush Color="White"/>
            </Button.Foreground>
        </Button>
    </Grid>
</Window>