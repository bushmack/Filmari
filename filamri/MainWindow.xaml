<Window x:Class="filamri.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="filamri - Поиск фильмов" 
        Height="750" 
        Width="1200"
        WindowStartupLocation="CenterScreen"
        Background="#FFF5F5F5"
        WindowState="Maximized">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Верхняя панель с кнопками -->
        <WrapPanel Grid.Row="0" Margin="0,0,0,15" HorizontalAlignment="Center">
            <Button Content="🎬 5 случайных фильмов" 
                    Click="LoadRandomMovies_Click" 
                    Width="160" Height="45" Margin="5"
                    Background="#FF0078D7" Foreground="White"
                    FontSize="14" FontWeight="Bold"
                    Cursor="Hand">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <Button Content="📺 5 случайных сериалов"
                    Click="LoadRandomSeries_Click"
                    Width="160" Height="45" Margin="5"
                    Background="#FF0078D7" Foreground="White"
                    FontSize="14" FontWeight="Bold"
                    Cursor="Hand">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <Button Content="🔍 Поиск по названию"
                    Click="NameSearch_Click"
                    Width="150" Height="45" Margin="5"
                    Background="#FF5C2E91" Foreground="White"
                    FontSize="14" FontWeight="Bold"
                    Cursor="Hand">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <Button Content="🎭 Поиск по актерам"
                    Click="ActorSearch_Click"
                    Width="150" Height="45" Margin="5"
                    Background="#FF5C2E91" Foreground="White"
                    FontSize="14" FontWeight="Bold"
                    Cursor="Hand">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <Button Content="⚡ Поиск по фильтру"
                    Click="FilterSearch_Click"
                    Width="140" Height="45" Margin="5"
                    Background="#FFD83B01" Foreground="White"
                    FontSize="14" FontWeight="Bold"
                    Cursor="Hand">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <Button Content="🤝 Совместный поиск"
                    Click="CombinedSearch_Click"
                    Width="150" Height="45" Margin="5"
                    Background="#FFD83B01" Foreground="White"
                    FontSize="14" FontWeight="Bold"
                    Cursor="Hand">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <Button Content="📚 Мои подборки"
                    Click="MyCollections_Click"
                    Width="130" Height="45" Margin="5"
                    Background="#FF107C10" Foreground="White"
                    FontSize="14" FontWeight="Bold"
                    Cursor="Hand">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </WrapPanel>

        <!-- КОНТЕЙНЕР ДЛЯ ФИЛЬМОВ - ВАЖНО! -->
        <ScrollViewer Grid.Row="1" 
                      VerticalScrollBarVisibility="Auto"
                      Background="White"
                      BorderBrush="#FFDDDDDD" 
                      BorderThickness="1">
            <StackPanel x:Name="FilmContainer" Margin="10"/>
        </ScrollViewer>
    </Grid>
</Window>