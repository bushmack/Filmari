<Window x:Class="filamri.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="filamri - Кино на максималках" 
        Height="900" 
        Width="1400"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="{StaticResource DarkGradient}">

    <Window.Effect>
        <DropShadowEffect BlurRadius="30" Opacity="0.2"/>
    </Window.Effect>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Стеклянная панель с кнопками -->
        <Border Grid.Row="0" 
                Background="#CC2D3436" 
                CornerRadius="30" 
                Margin="0,0,0,25"
                Padding="20,15"
                Effect="{StaticResource CardShadow}">

            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">

                    <Button Content="🎬 Случайные фильмы" 
                            Click="LoadRandomMovies_Click" 
                            Width="180" Height="50" Margin="5"
                            Background="{StaticResource PrimaryGradient}"
                            Style="{StaticResource NeonButton}"/>
                    
                    

                    <Button Content="📺 Случайные сериалы"
                            Click="LoadRandomSeries_Click"
                            Width="180" Height="50" Margin="5"
                            Background="{StaticResource SecondaryGradient}"
                            Style="{StaticResource NeonButton}"/>

                    
                    
                    <Button Content="🔍 Поиск"
                            Click="NameSearch_Click"
                            Width="150" Height="50" Margin="5"
                            Background="#FF6C5CE7"
                            Style="{StaticResource NeonButton}"/>

                    <Button Content="🎭 Актеры"
                            Click="ActorSearch_Click"
                            Width="150" Height="50" Margin="5"
                            Background="#FF00B894"
                            Style="{StaticResource NeonButton}"/>

                    <Button Content="⚡ Фильтр"
                            Click="FilterSearch_Click"
                            Width="140" Height="50" Margin="5"
                            Background="#FFFD79A8"
                            Style="{StaticResource NeonButton}"/>

                    <Button Content="🤝 Вместе"
                            Click="CombinedSearch_Click"
                            Width="150" Height="50" Margin="5"
                            Background="#FFFDCB6E"
                            Style="{StaticResource NeonButton}"/>

                    <Button Content="📚 Подборки"
                            Click="MyCollections_Click"
                            Width="140" Height="50" Margin="5"
                            Background="{StaticResource SecondaryGradient}"
                            Style="{StaticResource NeonButton}"/>

                    <Button Content="👤 Профиль"
                            Click="OpenProfile_Click"
                            Width="140" Height="50" Margin="5"
                            Background="#FF6C5CE7"
                            Style="{StaticResource NeonButton}"/>

                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Контейнер для фильмов - БЕЗ СКРОЛЛА -->
        <Border Grid.Row="1" 
                Background="#CCFFFFFF" 
                CornerRadius="30" 
                Padding="20"
                Effect="{StaticResource CardShadow}">

            <StackPanel x:Name="FilmContainer" Margin="10" VerticalAlignment="Top"/>

        </Border>
    </Grid>
</Window>