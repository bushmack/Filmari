<Window x:Class="filamri.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="filamri - Поиск фильмов" Height="750" Width="1200"
        WindowStartupLocation="CenterScreen"
        Background="#FFF5F5F5">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Верхняя панель с кнопками -->
        <WrapPanel Grid.Row="0" Margin="0,0,0,15" HorizontalAlignment="Center">
            <Button Content="🎬 5 случайных фильмов" 
                    Click="LoadRandomMovies_Click" 
                    Width="160" Height="45" Margin="5">
                <Button.Background>
                    <SolidColorBrush Color="#FF0078D7"/>
                </Button.Background>
                <Button.Foreground>
                    <SolidColorBrush Color="White"/>
                </Button.Foreground>
            </Button>

            <Button Content="📺 5 случайных сериалов"
                    Click="LoadRandomSeries_Click"
                    Width="160" Height="45" Margin="5">
                <Button.Background>
                    <SolidColorBrush Color="#FF0078D7"/>
                </Button.Background>
                <Button.Foreground>
                    <SolidColorBrush Color="White"/>
                </Button.Foreground>
            </Button>

            <Button Content="🔍 Поиск по названию"
                    Click="NameSearch_Click"
                    Width="150" Height="45" Margin="5">
                <Button.Background>
                    <SolidColorBrush Color="#FF5C2E91"/>
                </Button.Background>
                <Button.Foreground>
                    <SolidColorBrush Color="White"/>
                </Button.Foreground>
            </Button>

            <Button Content="🎭 Поиск по актерам"
                    Click="ActorSearch_Click"
                    Width="150" Height="45" Margin="5">
                <Button.Background>
                    <SolidColorBrush Color="#FF5C2E91"/>
                </Button.Background>
                <Button.Foreground>
                    <SolidColorBrush Color="White"/>
                </Button.Foreground>
            </Button>

            <Button Content="⚡ Поиск по фильтру"
                    Click="FilterSearch_Click"
                    Width="140" Height="45" Margin="5">
                <Button.Background>
                    <SolidColorBrush Color="#FFD83B01"/>
                </Button.Background>
                <Button.Foreground>
                    <SolidColorBrush Color="White"/>
                </Button.Foreground>
            </Button>

            <Button Content="🤝 Совместный поиск"
                    Click="CombinedSearch_Click"
                    Width="150" Height="45" Margin="5">
                <Button.Background>
                    <SolidColorBrush Color="#FFD83B01"/>
                </Button.Background>
                <Button.Foreground>
                    <SolidColorBrush Color="White"/>
                </Button.Foreground>
            </Button>

            <Button Content="📚 Мои подборки"
                    Click="MyCollections_Click"
                    Width="130" Height="45" Margin="5">
                <Button.Background>
                    <SolidColorBrush Color="#FF107C10"/>
                </Button.Background>
                <Button.Foreground>
                    <SolidColorBrush Color="White"/>
                </Button.Foreground>
            </Button>
        </WrapPanel>

        <!-- Контейнер для контента -->
        <ContentControl Grid.Row="1" x:Name="MainContent"/>
    </Grid>
</Window>