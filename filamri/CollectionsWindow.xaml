<Window x:Class="filamri.CollectionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="📚 Мои подборки" 
        Height="700" 
        Width="900"
        WindowStartupLocation="CenterOwner"
        WindowStyle="ToolWindow"
        ResizeMode="NoResize"
        Background="#FF2D3436"
        FontFamily="Segoe UI">

    <Window.Resources>
        <Style x:Key="GlassCard" TargetType="Border">
            <Setter Property="Background" Value="#CCFFFFFF"/>
            <Setter Property="CornerRadius" Value="20"/>
            <Setter Property="Margin" Value="0,0,0,15"/>
            <Setter Property="Padding" Value="20"/>
        </Style>

        <Style x:Key="NeonButton" TargetType="Button">
            <Setter Property="Height" Value="45"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                CornerRadius="25"
                                Background="{TemplateBinding Background}"
                                BorderThickness="0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="#CC2D3436" 
            CornerRadius="30" 
            Margin="20"
            Padding="25">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Заголовок -->
            <TextBlock Grid.Row="0" 
                       Text="📚 Мои подборки" 
                       FontSize="36" 
                       FontWeight="Bold" 
                       HorizontalAlignment="Center" 
                       Margin="0,0,0,25"
                       Foreground="White"/>

            <!-- Список подборок -->
            <ScrollViewer Grid.Row="1" 
                          VerticalScrollBarVisibility="Disabled" 
                          HorizontalScrollBarVisibility="Disabled"
                          Margin="0,0,0,15">
                <ItemsControl x:Name="CollectionsList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource GlassCard}" Cursor="Hand" MouseLeftButtonUp="Border_MouseLeftButtonUp" Tag="{Binding}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding Name}" 
                                                   FontSize="22" 
                                                   FontWeight="Bold"
                                                   Foreground="#2D3436"
                                                   Margin="0,0,0,5"/>
                                        <TextBlock>
                                            <TextBlock.Text>
                                                <MultiBinding StringFormat="{}{0} фильмов">
                                                    <Binding Path="Movies.Count"/>
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                    </StackPanel>

                                    <Button Grid.Column="1" 
                                            Content="👁️ Открыть" 
                                            Width="100" 
                                            Height="40"
                                            Background="#6C5CE7"
                                            Foreground="White"
                                            FontSize="14"
                                            FontWeight="Bold"
                                            Tag="{Binding}"
                                            Click="OpenCollection_Click"
                                            Style="{StaticResource NeonButton}"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Кнопка создания подборки -->
            <Button Grid.Row="2" 
                    Content="➕ Создать новую подборку" 
                    Height="50"
                    Width="250"
                    HorizontalAlignment="Center"
                    Background="#00B894"
                    Foreground="White"
                    FontSize="16"
                    FontWeight="Bold"
                    Click="CreateNewCollection_Click"
                    Style="{StaticResource NeonButton}"/>
        </Grid>
    </Border>
</Window>