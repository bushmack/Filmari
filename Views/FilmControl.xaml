<UserControl x:Class="OneButtonApp.Views.FilmControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Background="WhiteSmoke" BorderBrush="Gray" BorderThickness="1" CornerRadius="5" Margin="5">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="9"/>
                <RowDefinition Height="151"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Image Grid.Row="0" x:Name="PosterImage" Height="150" Stretch="Uniform" Margin="5,5,5,5" Grid.RowSpan="2"/>

            <StackPanel Grid.Row="2" Margin="10,10,10,10">
                <TextBlock x:Name="TitleText" FontSize="16" FontWeight="Bold"/>
                <TextBlock x:Name="DescriptionText" FontSize="12" TextWrapping="Wrap" Margin="0,5"/>
                <TextBlock x:Name="YearText" FontSize="10" Foreground="Gray" Margin="0,2"/>
                <TextBlock x:Name="GenreText" FontSize="10" Foreground="Gray" Margin="0,2"/>
                <TextBlock x:Name="RatingText" FontSize="10" Foreground="Gold" Margin="0,2"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>