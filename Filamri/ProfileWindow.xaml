<Window x:Class="filamri.ProfileWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="👤 Личный кабинет" 
        Height="600" 
        Width="550"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Window.Resources>
        <!-- Градиенты -->
        <LinearGradientBrush x:Key="BackgroundGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#1A1A2E" Offset="0"/>
            <GradientStop Color="#16213E" Offset="0.5"/>
            <GradientStop Color="#0F3460" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="ButtonGradient" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#6C5CE7" Offset="0"/>
            <GradientStop Color="#A29BFE" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="SuccessGradient" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#00B894" Offset="0"/>
            <GradientStop Color="#55EFC4" Offset="1"/>
        </LinearGradientBrush>

        <!-- Тени -->
        <DropShadowEffect x:Key="CardShadow" BlurRadius="25" Opacity="0.3" ShadowDepth="5" Color="Black"/>
        <DropShadowEffect x:Key="GlowEffect" BlurRadius="15" Opacity="0.8" Color="#6C5CE7"/>

        <!-- Стиль кнопок -->
        <Style x:Key="NeonButton" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="{StaticResource ButtonGradient}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}"
                                CornerRadius="20"
                                BorderThickness="0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Effect" Value="{StaticResource GlowEffect}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Background" Value="#2A2A3E"/>
            <Setter Property="Foreground" Value="#A29BFE"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}"
                                CornerRadius="18"
                                BorderThickness="0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#6C5CE7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Стиль для статистических карточек -->
        <Style x:Key="StatCard" TargetType="Border">
            <Setter Property="Background" Value="#2A2A3E"/>
            <Setter Property="CornerRadius" Value="15"/>
            <Setter Property="Padding" Value="15"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Effect" Value="{StaticResource CardShadow}"/>
        </Style>
    </Window.Resources>

    <Border Background="{StaticResource BackgroundGradient}" CornerRadius="30" Margin="10" Effect="{StaticResource CardShadow}">
        <Grid Margin="25">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Кнопка закрытия -->
            <Button Grid.Row="0" 
                    Content="✕" 
                    Width="32" 
                    Height="32" 
                    HorizontalAlignment="Right"
                    Background="#FF4444"
                    Foreground="White"
                    BorderThickness="0"
                    Click="CloseButton_Click"
                    Cursor="Hand"/>

            <!-- Аватар -->
            <Grid Grid.Row="1" HorizontalAlignment="Center" Margin="0,10,0,15">
                <Grid Width="140" Height="140">
                    <Ellipse Fill="{StaticResource ButtonGradient}" 
                             Width="144" 
                             Height="144" 
                             HorizontalAlignment="Center" 
                             VerticalAlignment="Center"
                             Effect="{StaticResource GlowEffect}"/>
                    <Ellipse Fill="#2A2A3E" 
                             Width="134" 
                             Height="134" 
                             HorizontalAlignment="Center" 
                             VerticalAlignment="Center"/>
                    <Image x:Name="AvatarImage" 
                           Width="130" 
                           Height="130" 
                           Stretch="UniformToFill">
                        <Image.Clip>
                            <EllipseGeometry Center="65,65" RadiusX="65" RadiusY="65"/>
                        </Image.Clip>
                    </Image>
                </Grid>
                <Button x:Name="ChangeAvatarButton" 
                        Content="📷" 
                        Width="36" 
                        Height="36"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        Style="{StaticResource IconButton}"
                        Click="ChangeAvatarButton_Click"
                        ToolTip="Сменить аватар"/>
            </Grid>

            <!-- Имя -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,15">
                <TextBlock x:Name="NameText" 
                           FontSize="28" 
                           FontWeight="Bold" 
                           Foreground="White"
                           Text="Пользователь"/>
                <Button x:Name="EditNameButton" 
                        Content="✏️" 
                        Margin="12,0,0,0"
                        Style="{StaticResource IconButton}"
                        Click="EditNameButton_Click"
                        ToolTip="Изменить имя"/>
            </StackPanel>

            <!-- ID -->
            <Border Grid.Row="3" 
                    Background="#2A2A3E" 
                    CornerRadius="20" 
                    Padding="12,6"
                    HorizontalAlignment="Center"
                    Margin="0,0,0,20">
                <TextBlock x:Name="UserIdText" 
                           FontSize="12" 
                           Foreground="#A29BFE"
                           FontFamily="Consolas"/>
            </Border>

            <!-- Прогресс -->
            <Border Grid.Row="4" 
                    Background="#2A2A3E" 
                    CornerRadius="20" 
                    Padding="20,15"
                    Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="📊 ПРОГРЕСС" 
                               FontSize="12" 
                               Foreground="#A29BFE"
                               HorizontalAlignment="Center"/>
                    <TextBlock x:Name="ProgressText" 
                               FontSize="24" 
                               FontWeight="Bold" 
                               Foreground="White"
                               HorizontalAlignment="Center"
                               Margin="0,8,0,8"/>
                    <ProgressBar x:Name="ProgressBar" 
                                 Height="8" 
                                 Minimum="0" 
                                 Maximum="100" 
                                 Value="0"
                                 Foreground="{StaticResource SuccessGradient}"
                                 Background="#1A1A2E"/>
                    <TextBlock Text="Каждый фильм в подборке даёт +0.25 к прогрессу"
                               FontSize="10"
                               Foreground="#888888"
                               HorizontalAlignment="Center"
                               Margin="0,10,0,0"/>
                </StackPanel>
            </Border>

            <!-- Статистика -->
            <Grid Grid.Row="5" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource StatCard}">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="🎬" FontSize="32" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="TotalMoviesText" 
                                   Text="0" 
                                   FontSize="28" 
                                   FontWeight="Bold" 
                                   Foreground="White"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="фильмов в подборках" 
                                   FontSize="11" 
                                   Foreground="#888888"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource StatCard}">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="🏆" FontSize="32" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="NextLevelText" 
                                   Text="4" 
                                   FontSize="28" 
                                   FontWeight="Bold" 
                                   Foreground="White"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="до следующего уровня" 
                                   FontSize="11" 
                                   Foreground="#888888"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>