<Window x:Class="filamri.CommentsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="💬 Комментарии" Height="550" Width="600"
        WindowStartupLocation="CenterOwner"
        Background="#FFF5F5F5"
        WindowStyle="ToolWindow"
        ResizeMode="NoResize">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <TextBlock x:Name="MovieTitleText" Grid.Row="0"
                   FontSize="24" FontWeight="Bold"
                   Margin="0,0,0,10"
                   TextWrapping="Wrap"/>

        <!-- Список комментариев -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="CommentsList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="#DDD" BorderThickness="0,0,0,1"
                                Margin="0,5" Padding="5">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0"
                                           Text="{Binding UserName}"
                                           FontWeight="Bold"
                                           Foreground="#FF0078D7"/>
                                <TextBlock Grid.Row="0" Grid.Column="1"
                                           Text="{Binding Timestamp}"
                                           FontSize="11"
                                           Foreground="Gray"/>
                                <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                           Text="{Binding Text}"
                                           TextWrapping="Wrap"
                                           Margin="0,5,0,0"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Сообщение "Нет комментариев" -->
        <TextBlock x:Name="EmptyStateText" Grid.Row="1"
                   Text="😢 Пока нет комментариев. Будьте первым!"
                   FontSize="16"
                   Foreground="Gray"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Visibility="Collapsed"/>

        <!-- Поле ввода -->
        <Grid Grid.Row="2" Margin="0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="CommentTextBox"
                     Grid.Column="0"
                     Height="80"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     Padding="5"
                     BorderBrush="#DDD"
                     BorderThickness="1"
                     VerticalScrollBarVisibility="Auto"/>
            <Button x:Name="AddCommentButton"
                    Grid.Column="1"
                    Content="Отправить"
                    Width="80"
                    Height="30"
                    Margin="5,0,0,0"
                    Click="AddCommentButton_Click"
                    IsEnabled="False"/>
        </Grid>
    </Grid>
</Window>