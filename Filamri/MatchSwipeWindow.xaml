<Window x:Class="filamri.MatchSwipeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="🔍 Поиск фильмов" 
        Height="700" 
        Width="900"
        WindowStartupLocation="CenterOwner"
        Background="#1A1A2E"
        WindowStyle="ToolWindow"
        ResizeMode="NoResize">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,15">
            <Border Background="#2A2A3E" CornerRadius="15" Padding="12,6">
                <TextBlock x:Name="RoomInfoText" FontSize="12" Foreground="#A29BFE"/>
            </Border>
            <Border Background="#2A2A3E" CornerRadius="15" Padding="12,6" Margin="10,0,0,0">
                <TextBlock x:Name="PartnerStatusText" FontSize="12" Foreground="#A29BFE"/>
            </Border>
        </StackPanel>

        <Border Grid.Row="1" Background="#2A2A3E" CornerRadius="20" Padding="20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="300"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Image x:Name="PosterImage" Grid.Column="0" Height="400" Stretch="Uniform" Margin="10"/>

                <StackPanel Grid.Column="1" Margin="10">
                    <TextBlock x:Name="TitleText" FontSize="24" FontWeight="Bold" Foreground="White" TextWrapping="Wrap"/>
                    <WrapPanel Margin="0,10,0,10">
                        <TextBlock x:Name="YearText" FontSize="14" Foreground="#888888" Margin="0,0,15,0"/>
                        <TextBlock x:Name="GenreText" FontSize="14" Foreground="#888888" Margin="0,0,15,0"/>
                        <TextBlock x:Name="RatingText" FontSize="14" Foreground="Gold"/>
                    </WrapPanel>
                    <TextBlock x:Name="CountryText" FontSize="14" Foreground="#888888"/>
                    <TextBlock x:Name="LengthText" FontSize="14" Foreground="#888888" Margin="0,5,0,15"/>
                    <TextBlock Text="Описание:" FontSize="16" FontWeight="Bold" Foreground="White"/>
                    <ScrollViewer MaxHeight="150">
                        <TextBlock x:Name="DescriptionText" FontSize="14" Foreground="#CCCCCC" TextWrapping="Wrap"/>
                    </ScrollViewer>
                    <TextBlock Text="Актеры:" FontSize="16" FontWeight="Bold" Foreground="White" Margin="0,15,0,5"/>
                    <TextBlock x:Name="ActorsText" FontSize="13" Foreground="#888888" TextWrapping="Wrap"/>
                </StackPanel>
            </Grid>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,15">
            <Button x:Name="PrevButton" Content="◀" Width="50" Height="50" FontSize="24" Background="#FF4444" Foreground="White" Click="PrevButton_Click" Margin="5"/>
            <TextBlock x:Name="CounterText" FontSize="18" Foreground="White" VerticalAlignment="Center" Margin="20,0" MinWidth="80" TextAlignment="Center"/>
            <Button x:Name="NextButton" Content="▶" Width="50" Height="50" FontSize="24" Background="#FF4444" Foreground="White" Click="NextButton_Click" Margin="5"/>
        </StackPanel>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,10">
            <Button x:Name="DislikeButton" Content="💔 Не нравится" Width="180" Height="50" FontSize="16" Background="#FF4444" Foreground="White" Click="DislikeButton_Click" Margin="10"/>
            <Button x:Name="LikeButton" Content="❤️ Нравится" Width="180" Height="50" FontSize="16" Background="#00B894" Foreground="White" Click="LikeButton_Click" Margin="10"/>
            <Button x:Name="ExitButton" Content="🚪 Выйти" Width="120" Height="50" FontSize="16" Background="#6C5CE7" Foreground="White" Click="ExitButton_Click" Margin="10"/>
        </StackPanel>
    </Grid>
</Window>