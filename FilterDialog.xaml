<Window x:Class="OneButtonApp.FilterDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Поиск по фильтру" Height="350" Width="400"
        WindowStartupLocation="CenterOwner"
        WindowStyle="ToolWindow"
        ResizeMode="NoResize">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="100"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Жанр -->
        <TextBlock Grid.Row="0" Grid.Column="0" Text="Жанр:" VerticalAlignment="Center" Margin="0,0,10,10"/>
        <TextBox Grid.Row="0" Grid.Column="1" x:Name="GenreTextBox" Margin="0,0,0,10" Padding="5"/>

        <!-- Год с -->
        <TextBlock Grid.Row="1" Grid.Column="0" Text="Год с:" VerticalAlignment="Center" Margin="0,0,10,10"/>
        <TextBox Grid.Row="1" Grid.Column="1" x:Name="YearFromTextBox" Margin="0,0,0,10" Padding="5"/>

        <!-- Год по -->
        <TextBlock Grid.Row="2" Grid.Column="0" Text="Год по:" VerticalAlignment="Center" Margin="0,0,10,10"/>
        <TextBox Grid.Row="2" Grid.Column="1" x:Name="YearToTextBox" Margin="0,0,0,10" Padding="5"/>

        <!-- Рейтинг от -->
        <TextBlock Grid.Row="3" Grid.Column="0" Text="Рейтинг от:" VerticalAlignment="Center" Margin="0,0,10,10"/>
        <TextBox Grid.Row="3" Grid.Column="1" x:Name="RatingFromTextBox" Margin="0,0,0,10" Padding="5"/>

        <!-- Рейтинг до -->
        <TextBlock Grid.Row="4" Grid.Column="0" Text="Рейтинг до:" VerticalAlignment="Center" Margin="0,0,10,10"/>
        <TextBox Grid.Row="4" Grid.Column="1" x:Name="RatingToTextBox" Margin="0,0,0,10" Padding="5"/>

        <!-- Страна -->
        <TextBlock Grid.Row="5" Grid.Column="0" Text="Страна:" VerticalAlignment="Center" Margin="0,0,10,10"/>
        <TextBox Grid.Row="5" Grid.Column="1" x:Name="CountryTextBox" Margin="0,0,0,10" Padding="5"/>

        <!-- Кнопки -->
        <StackPanel Grid.Row="6" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Поиск" Width="80" Height="30" Margin="0,0,10,0" Click="SearchButton_Click" IsDefault="True"/>
            <Button Content="Отмена" Width="80" Height="30" Click="CancelButton_Click" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>